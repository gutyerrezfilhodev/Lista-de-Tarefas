<body>

<div class="app">
  <h1>Lista de Tarefas - Gutyerrez Filho</h1>
  <p class="subtitle" id="date-subtitle"></p>

  <div class="tabs-nav">
    <button class="tab-btn active" data-tab="tasks">Tarefas</button>
    <button class="tab-btn" data-tab="diary">Diário</button>
  </div>

  <div class="tab-panel active" id="tab-tasks">
    <div class="boards-column" id="boards-column"></div>
  </div>

  <div class="tab-panel" id="tab-diary">
    <div class="diary-column">
      <div class="diary-panel">
        <h2>Diário de horários <span class="count" id="diary-count">0</span></h2>
        <div class="hour-timeline" id="hour-timeline"></div>
      </div>

      <div class="diary-panel">
        <h2>Relatório diário</h2>
        <div id="report-content"></div>
      </div>
    </div>
  </div>
</div>

<div class="modal-overlay" id="confirm-modal">
  <div class="modal-box">
    <p id="confirm-message">Essa tarefa foi realmente concluída?</p>
    <div class="modal-actions">
      <button class="modal-yes" id="confirm-yes">Sim</button>
      <button class="modal-no" id="confirm-no">Não</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="new-board-modal">
  <div class="modal-box">
    <p>Nome da nova lista de tarefas:</p>
    <input type="text" id="new-board-input" placeholder="Ex: Trabalho, Casa, Faculdade..." autocomplete="off">
    <div class="modal-actions">
      <button class="modal-yes" id="new-board-confirm">Criar</button>
      <button class="modal-no" id="new-board-cancel">Cancelar</button>
    </div>
  </div>
</div>

<script>
  // ---- Estado global ----
  let boards = [];
  let nextBoardId = 1;
  let expandedBoardId = null;

  // Controle de estado para a API de Drag and Drop
  let draggedTaskId = null;
  let draggedSourceBoardId = null;
  let draggedBoardId = null;

  const PRIORITY_ORDER = ['red', 'yellow', 'blue', 'green', null];
  const PRIORITY_COLORS = { red: '#e2685f', yellow: '#e0b93f', blue: '#4f9fe8', green: '#5fd88a', null: '#4a4e58' };

  const STORAGE_KEY = 'lista-de-tarefas-gutyerrez';

  function saveToStorage() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ boards, nextBoardId }));
    } catch (err) {
      console.error('Não foi possível salvar os dados:', err);
    }
  }

  function loadFromStorage() {
    try {
      const rawData = localStorage.getItem(STORAGE_KEY);
      if (!rawData) {
        boards = [{
          id: 1,
          name: 'Principal',
          tasks: [],
          doneTasks: [],
          nextId: 1
        }];
        nextBoardId = 2;
        expandedBoardId = 1;
        return;
      }
      
      const data = JSON.parse(rawData);

      if (Array.isArray(data.boards) && data.boards.length > 0) {
        boards = data.boards;
        nextBoardId = typeof data.nextBoardId === 'number'
          ? data.nextBoardId
          : (Math.max(0, ...boards.map(b => b.id)) + 1);
      } else {
        boards = [{
          id: 1,
          name: 'Principal',
          tasks: Array.isArray(data.tasks) ? data.tasks : [],
          doneTasks: Array.isArray(data.doneTasks) ? data.doneTasks : [],
          nextId: typeof data.nextId === 'number' ? data.nextId : 1
        }];
        nextBoardId = 2;
      }

      if (expandedBoardId === null && boards.length > 0) {
        expandedBoardId = boards[0].id;
      }

      boards.forEach(board => {
        (board.tasks || []).forEach(t => {
          t.editing = false;
          if (t.priority === undefined) t.priority = null;
        });
      });
    } catch (err) {
      console.error('Não foi possível carregar as listas salvas:', err);
      boards = [{ id: 1, name: 'Principal', tasks: [], doneTasks: [], nextId: 1 }];
      nextBoardId = 2;
      expandedBoardId = 1;
    }
  }

  const boardsColumn = document.getElementById('boards-column');
  const hourTimeline = document.getElementById('hour-timeline');
  const diaryCount = document.getElementById('diary-count');
  const reportContent = document.getElementById('report-content');

  function getBoard(id) {
    return boards.find(b => b.id === id);
  }

  // ---- Modais ----
  const confirmModal = document.getElementById('confirm-modal');
  const confirmMessage = document.getElementById('confirm-message');
  const confirmYes = document.getElementById('confirm-yes');
  const confirmNo = document.getElementById('confirm-no');
  let confirmCallback = null;

  function showConfirm(message, onYes) {
    confirmMessage.textContent = message;
    confirmCallback = onYes;
    confirmModal.classList.add('open');
  }

  function closeConfirmModal() {
    confirmCallback = null;
    confirmModal.classList.remove('open');
  }

  confirmYes.addEventListener('click', () => {
    const cb = confirmCallback;
    closeConfirmModal();
    if (cb) cb();
  });
  confirmNo.addEventListener('click', closeConfirmModal);
  confirmModal.addEventListener('click', (e) => {
    if (e.target === confirmModal) closeConfirmModal();
  });

  const newBoardModal = document.getElementById('new-board-modal');
  const newBoardInput = document.getElementById('new-board-input');

  function openNewBoardModal() {
    newBoardInput.value = '';
    newBoardModal.classList.add('open');
    setTimeout(() => newBoardInput.focus(), 50);
  }

  function closeNewBoardModal() {
    newBoardModal.classList.remove('open');
  }

  function createBoard() {
    const name = newBoardInput.value.trim();
    if (!name) { newBoardInput.focus(); return; }
    const board = { id: nextBoardId++, name, tasks: [], doneTasks: [], nextId: 1 };
    boards.push(board);
    expandedBoardId = board.id;
    saveToStorage();
    closeNewBoardModal();
    renderAll();
  }

  document.getElementById('new-board-confirm').addEventListener('click', createBoard);
  document.getElementById('new-board-cancel').addEventListener('click', closeNewBoardModal);
  newBoardInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); createBoard(); }
    if (e.key === 'Escape') closeNewBoardModal();
  });
  newBoardModal.addEventListener('click', (e) => {
    if (e.target === newBoardModal) closeNewBoardModal();
  });

  function confirmDeleteBoard(id) {
    const board = getBoard(id);
    if (!board) return;
    showConfirm(`Excluir a lista "${board.name}"? Essa ação não pode ser desfeita.`, () => {
      boards = boards.filter(b => b.id !== id);
      if (expandedBoardId === id) {
        expandedBoardId = boards.length > 0 ? boards[0].id : null;
      }
      saveToStorage();
      renderAll();
    });
  }

  // ---- Operações com Tarefas ----
  function addTask(boardId, text) {
    const board = getBoard(boardId);
    if (!board || !text.trim()) return;
    board.tasks.push({ id: board.nextId++, text: text.trim(), priority: null, editing: false });
    saveToStorage();
    renderAll();
  }

  function askComplete(boardId, taskId) {
    showConfirm('Essa tarefa foi realmente concluída?', () => {
      const board = getBoard(boardId);
      if (!board) return;
      const idx = board.tasks.findIndex(t => t.id === taskId);
      if (idx !== -1) {
        const [task] = board.tasks.splice(idx, 1);
        task.completedAt = new Date().toISOString();
        board.doneTasks.push(task);
        saveToStorage();
        renderAll();
      }
    });
  }

  function sortBoardTasks(board) {
    board.tasks.sort((a, b) => PRIORITY_ORDER.indexOf(a.priority || null) - PRIORITY_ORDER.indexOf(b.priority || null));
  }

  function setPriority(boardId, taskId, value) {
    const board = getBoard(boardId);
    if (!board) return;
    const task = board.tasks.find(t => t.id === taskId);
    if (!task) return;
    task.priority = value || null;
    sortBoardTasks(board);
    saveToStorage();
    renderAll();
  }

  function moveTaskToBoard(sourceBoardId, targetBoardId, taskId, targetIndex = null) {
    const sourceBoard = getBoard(sourceBoardId);
    const targetBoard = getBoard(targetBoardId);
    if (!sourceBoard || !targetBoard) return;

    const taskIndex = sourceBoard.tasks.findIndex(t => t.id === taskId);
    if (taskIndex === -1) return;

    const [task] = sourceBoard.tasks.splice(taskIndex, 1);
    
    if (sourceBoardId !== targetBoardId) {
      task.id = targetBoard.nextId++;
    }

    if (targetIndex !== null && targetIndex >= 0) {
      targetBoard.tasks.splice(targetIndex, 0, task);
    } else {
      targetBoard.tasks.push(task);
    }

    saveToStorage();
    renderAll();
  }

  function moveTask(boardId, taskId, direction) {
    const board = getBoard(boardId);
    if (!board) return;
    const idx = board.tasks.findIndex(t => t.id === taskId);
    if (idx === -1) return;
    const current = board.tasks[idx].priority || null;

    if (direction === 'up') {
      const prevIdx = idx - 1;
      if (prevIdx >= 0 && (board.tasks[prevIdx].priority || null) === current) {
        [board.tasks[prevIdx], board.tasks[idx]] = [board.tasks[idx], board.tasks[prevIdx]];
      }
    } else {
      const nextIdx = idx + 1;
      if (nextIdx < board.tasks.length && (board.tasks[nextIdx].priority || null) === current) {
        [board.tasks[idx], board.tasks[nextIdx]] = [board.tasks[nextIdx], board.tasks[idx]];
      }
    }
    saveToStorage();
    renderAll();
  }

  function moveBoard(boardId, direction) {
    const idx = boards.findIndex(b => b.id === boardId);
    if (idx === -1) return;

    if (direction === 'up' && idx > 0) {
      [boards[idx - 1], boards[idx]] = [boards[idx], boards[idx - 1]];
    } else if (direction === 'down' && idx < boards.length - 1) {
      [boards[idx], boards[idx + 1]] = [boards[idx + 1], boards[idx]];
    } else {
      return;
    }
    saveToStorage();
    renderBoardsColumn();
  }

  function reorderBoard(sourceBoardId, targetBoardId, insertBefore) {
    if (sourceBoardId === targetBoardId) return;
    const sourceIndex = boards.findIndex(b => b.id === sourceBoardId);
    if (sourceIndex === -1) return;
    const [movedBoard] = boards.splice(sourceIndex, 1);

    const targetIndex = boards.findIndex(b => b.id === targetBoardId);
    if (targetIndex === -1) {
      boards.push(movedBoard);
    } else {
      const insertIndex = insertBefore ? targetIndex : targetIndex + 1;
      boards.splice(insertIndex, 0, movedBoard);
    }

    saveToStorage();
    renderBoardsColumn();
  }

  function startEdit(boardId, taskId) {
    const board = getBoard(boardId);
    if (!board) return;
    const task = board.tasks.find(t => t.id === taskId);
    if (!task) return;
    task.editing = true;
    renderAll();
  }

  function saveEdit(boardId, taskId, newText) {
    const board = getBoard(boardId);
    if (!board) return;
    const task = board.tasks.find(t => t.id === taskId);
    if (!task) return;
    const trimmed = newText.trim();
    if (trimmed) task.text = trimmed;
    task.editing = false;
    saveToStorage();
    renderAll();
  }

  function deleteTask(boardId, taskId, fromDone) {
    const board = getBoard(boardId);
    if (!board) return;
    if (fromDone) {
      board.doneTasks = board.doneTasks.filter(t => t.id !== taskId);
    } else {
      board.tasks = board.tasks.filter(t => t.id !== taskId);
    }
    saveToStorage();
    renderAll();
  }

  // ---- Renderização ----
  function renderAll() {
    renderBoardsColumn();
    renderDiary();
  }

  function renderBoardsColumn() {
    boardsColumn.innerHTML = '';

    boards.forEach(board => {
      boardsColumn.appendChild(buildBoardBox(board));
    });

    const newCard = document.createElement('div');
    newCard.className = 'new-board-card';
    newCard.innerHTML = '<span>+</span><span>Criar Lista de Tarefas</span>';
    newCard.addEventListener('click', openNewBoardModal);
    boardsColumn.appendChild(newCard);
  }

  function buildBoardBox(board) {
    const isExpanded = expandedBoardId === board.id;

    const box = document.createElement('div');
    box.className = 'board-box';
    box.dataset.boardId = board.id;

    // EVENTOS DE DRAG & DROP NA CAIXA DA LISTA (Drop Target)
    box.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (draggedBoardId !== null) {
        // Arrastando uma lista inteira: indica se vai inserir antes ou depois desta caixa
        if (draggedBoardId !== board.id) {
          const rect = box.getBoundingClientRect();
          const isTopHalf = (e.clientY - rect.top) < rect.height / 2;
          box.classList.toggle('board-insert-before', isTopHalf);
          box.classList.toggle('board-insert-after', !isTopHalf);
        }
      } else if (draggedTaskId !== null) {
        box.classList.add('drag-over');
      }
    });

    box.addEventListener('dragleave', (e) => {
      if (!box.contains(e.relatedTarget)) {
        box.classList.remove('drag-over');
        box.classList.remove('board-insert-before');
        box.classList.remove('board-insert-after');
      }
    });

    box.addEventListener('drop', (e) => {
      e.preventDefault();
      const insertBefore = box.classList.contains('board-insert-before');
      box.classList.remove('drag-over');
      box.classList.remove('board-insert-before');
      box.classList.remove('board-insert-after');

      if (draggedBoardId !== null) {
        reorderBoard(draggedBoardId, board.id, insertBefore);
        return;
      }

      // Se soltar na área geral do box e não em um item específico, adiciona no final da lista
      if (draggedTaskId !== null && draggedSourceBoardId !== null) {
        if (!e.target.closest('li')) {
          moveTaskToBoard(draggedSourceBoardId, board.id, draggedTaskId);
        }
      }
    });

    const boardIndex = boards.indexOf(board);
    const isFirstBoard = boardIndex === 0;
    const isLastBoard = boardIndex === boards.length - 1;

    const header = document.createElement('div');
    header.className = 'board-box-header';
    header.innerHTML = `
      <span class="drag-handle" title="Arrastar lista" draggable="true">&#9776;</span>
      <div class="move-group">
        <button class="move-btn board-move-up" title="Mover lista para cima" ${isFirstBoard ? 'disabled' : ''}>&#9650;</button>
        <button class="move-btn board-move-down" title="Mover lista para baixo" ${isLastBoard ? 'disabled' : ''}>&#9660;</button>
      </div>
      <button class="rename-btn" title="Renomear lista">&#9998;</button>
      <h3 class="board-name-text"></h3>
      <span class="board-mini-stats">${board.tasks.length}p · ${board.doneTasks.length}c</span>
      <button class="board-delete-btn" title="Excluir lista">&times;</button>
    `;
    header.querySelector('.board-name-text').textContent = board.name;

    const boardDragHandle = header.querySelector('.drag-handle');
    boardDragHandle.addEventListener('click', (e) => e.stopPropagation());
    boardDragHandle.addEventListener('dragstart', (e) => {
      e.stopPropagation();
      draggedBoardId = board.id;
      box.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', String(board.id));
    });
    boardDragHandle.addEventListener('dragend', (e) => {
      e.stopPropagation();
      draggedBoardId = null;
      document.querySelectorAll('.board-box.dragging').forEach(el => el.classList.remove('dragging'));
      document.querySelectorAll('.board-insert-before, .board-insert-after').forEach(el => {
        el.classList.remove('board-insert-before', 'board-insert-after');
      });
    });

    header.querySelector('.board-move-up').addEventListener('click', (e) => {
      e.stopPropagation();
      moveBoard(board.id, 'up');
    });

    header.querySelector('.board-move-down').addEventListener('click', (e) => {
      e.stopPropagation();
      moveBoard(board.id, 'down');
    });

    header.querySelector('.rename-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      startRenameBoard(board, header);
    });

    header.querySelector('.board-delete-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      confirmDeleteBoard(board.id);
    });

    header.addEventListener('click', () => {
      expandedBoardId = isExpanded ? null : board.id;
      renderBoardsColumn();
    });

    box.appendChild(header);

    if (isExpanded) {
      const body = document.createElement('div');
      body.className = 'board-box-body';

      const form = document.createElement('div');
      form.className = 'mini-task-form';
      form.innerHTML = `
        <input type="text" class="mini-task-input" placeholder="O que você precisa fazer?" autocomplete="off">
        <button type="button" class="add-btn">Adicionar</button>
      `;
      const miniInput = form.querySelector('.mini-task-input');
      const miniAddBtn = form.querySelector('.add-btn');
      form.addEventListener('click', (e) => e.stopPropagation());
      function submitMiniTask() {
        addTask(board.id, miniInput.value);
      }
      miniAddBtn.addEventListener('click', submitMiniTask);
      miniInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submitMiniTask();
        }
      });
      body.appendChild(form);

      const list = document.createElement('ul');
      list.className = 'mini-pending-list';
      renderPendingTasks(board, list);
      body.appendChild(list);

      box.appendChild(body);
    }

    return box;
  }

  function startRenameBoard(board, header) {
    const nameEl = header.querySelector('.board-name-text');
    const inputEl = document.createElement('input');
    inputEl.type = 'text';
    inputEl.className = 'board-rename-input';
    inputEl.value = board.name;
    inputEl.addEventListener('click', (e) => e.stopPropagation());
    nameEl.replaceWith(inputEl);
    inputEl.focus();
    inputEl.select();

    function commit() {
      const newName = inputEl.value.trim();
      if (newName) {
        board.name = newName;
        saveToStorage();
      }
      renderBoardsColumn();
    }

    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') commit();
      if (e.key === 'Escape') renderBoardsColumn();
    });
    inputEl.addEventListener('blur', commit);
  }

  function renderPendingTasks(board, list) {
    list.innerHTML = '';

    if (board.tasks.length === 0) {
      list.innerHTML = '<li style="all:unset; cursor:default;"><div class="empty-msg" style="width:100%">Nenhuma tarefa pendente.</div></li>';
      return;
    }

    const boardOptions = boards
      .filter(b => b.id !== board.id)
      .map(b => `<option value="${b.id}">${b.name.replace(/"/g, '&quot;')}</option>`)
      .join('');
    const hasOtherBoards = boardOptions.length > 0;

    board.tasks.forEach((task, i) => {
      const li = document.createElement('li');
      li.draggable = true;
      li.dataset.taskId = task.id;
      li.dataset.boardId = board.id;

      const priority = task.priority || null;
      if (priority) li.classList.add('pri-' + priority);

      const isFirstInGroup = i === 0 || (board.tasks[i - 1].priority || null) !== priority;
      const isLastInGroup = i === board.tasks.length - 1 || (board.tasks[i + 1].priority || null) !== priority;

      // EVENTOS DRAG AND DROP DO ITEM DA TAREFA
      li.addEventListener('dragstart', (e) => {
        draggedTaskId = task.id;
        draggedSourceBoardId = board.id;
        li.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', JSON.stringify({ boardId: board.id, taskId: task.id }));
      });

      li.addEventListener('dragend', () => {
        draggedTaskId = null;
        draggedSourceBoardId = null;
        li.classList.remove('dragging');
        document.querySelectorAll('.drag-over-item').forEach(el => el.classList.remove('drag-over-item'));
        document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
      });

      li.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (draggedTaskId !== null && draggedTaskId !== task.id) {
          li.classList.add('drag-over-item');
        }
      });

      li.addEventListener('dragleave', () => {
        li.classList.remove('drag-over-item');
      });

      li.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        li.classList.remove('drag-over-item');

        if (draggedTaskId !== null && draggedSourceBoardId !== null) {
          moveTaskToBoard(draggedSourceBoardId, board.id, draggedTaskId, i);
        }
      });

      if (task.editing) {
        li.draggable = false;
        li.innerHTML = `
          <div class="task-top-row">
            <div class="task-top-left">
              <span class="index">${i + 1}</span>
            </div>
            <div class="task-top-right">
              <button class="edit-btn" title="Salvar">&#10003;</button>
            </div>
          </div>
          <input type="text" class="edit-input" value="${task.text.replace(/"/g, '&quot;')}">
        `;
        const editInput = li.querySelector('.edit-input');
        editInput.addEventListener('click', (e) => e.stopPropagation());
        li.querySelector('.edit-btn').addEventListener('click', (e) => { e.stopPropagation(); saveEdit(board.id, task.id, editInput.value); });
        editInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') saveEdit(board.id, task.id, editInput.value);
          if (e.key === 'Escape') { task.editing = false; renderAll(); }
        });
        list.appendChild(li);
        editInput.focus();
        editInput.select();
        return;
      }

      li.innerHTML = `
        <div class="task-top-row">
          <div class="task-top-left">
            <span class="drag-handle" title="Arrastar tarefa">&#9776;</span>
            <span class="index">${i + 1}</span>
            <div class="move-group">
              <button class="move-btn move-up" title="Mover para cima" ${isFirstInGroup ? 'disabled' : ''}>&#9650;</button>
              <button class="move-btn move-down" title="Mover para baixo" ${isLastInGroup ? 'disabled' : ''}>&#9660;</button>
            </div>
            <button class="check-btn" title="Marcar como concluída"></button>
          </div>
          <div class="task-top-right">
            ${hasOtherBoards ? `
              <select class="move-board-select" title="Mover para outra lista">
                <option value="" disabled selected>Mover p/...</option>
                ${boardOptions}
              </select>
            ` : ''}
            <select class="priority-select" title="Classificar prioridade">
              <option value="">Sem cor</option>
              <option value="red">Urgente</option>
              <option value="yellow">Média</option>
              <option value="blue">Baixa</option>
              <option value="green">Adiável</option>
            </select>
            <button class="edit-btn" title="Editar">&#9998;</button>
            <button class="delete-btn" title="Excluir">&times;</button>
          </div>
        </div>
        <span class="task-text"></span>
      `;
      li.addEventListener('click', (e) => e.stopPropagation());
      li.querySelector('.task-text').textContent = task.text;

      const select = li.querySelector('.priority-select');
      select.value = priority || '';
      select.style.background = PRIORITY_COLORS[priority || null];
      select.addEventListener('change', (e) => setPriority(board.id, task.id, e.target.value));

      const moveSelect = li.querySelector('.move-board-select');
      if (moveSelect) {
        moveSelect.addEventListener('change', (e) => {
          const targetBoardId = parseInt(e.target.value, 10);
          if (targetBoardId) {
            moveTaskToBoard(board.id, targetBoardId, task.id);
          }
        });
      }

      li.querySelector('.move-up').addEventListener('click', () => moveTask(board.id, task.id, 'up'));
      li.querySelector('.move-down').addEventListener('click', () => moveTask(board.id, task.id, 'down'));
      li.querySelector('.check-btn').addEventListener('click', () => askComplete(board.id, task.id));
      li.querySelector('.edit-btn').addEventListener('click', () => startEdit(board.id, task.id));
      li.querySelector('.delete-btn').addEventListener('click', () => deleteTask(board.id, task.id, false));
      list.appendChild(li);
    });
  }

  // ---- Diário ----
  function getAllDoneTasks() {
    let all = [];
    boards.forEach(board => {
      board.doneTasks.forEach(t => all.push({ ...t, boardId: board.id, boardName: board.name }));
    });
    return all;
  }

  function formatHourLabel(h) {
    return `${h}h`;
  }

  function formatTime(iso) {
    const d = new Date(iso);
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    return `${hh}:${mm}`;
  }

  function renderDiary() {
    const all = getAllDoneTasks();
    diaryCount.textContent = all.length;
    renderHourTimeline(all);
    renderDailyReport(all);
  }

  function renderHourTimeline(all) {
    hourTimeline.innerHTML = '';

    const semHorario = all.filter(t => !t.completedAt);
    if (semHorario.length > 0) {
      hourTimeline.appendChild(buildHourRow('Sem horário', semHorario));
    }

    for (let h = 0; h < 24; h++) {
      const tasksAtHour = all.filter(t => t.completedAt && new Date(t.completedAt).getHours() === h);
      hourTimeline.appendChild(buildHourRow(formatHourLabel(h), tasksAtHour));
    }
  }

  function buildHourRow(label, tasksAtHour) {
    const row = document.createElement('div');
    row.className = 'hour-row' + (tasksAtHour.length > 0 ? ' has-tasks' : '');

    const labelEl = document.createElement('span');
    labelEl.className = 'hour-label';
    labelEl.textContent = label;
    row.appendChild(labelEl);

    const tasksWrap = document.createElement('div');
    tasksWrap.className = 'hour-tasks';

    if (tasksAtHour.length === 0) {
      const empty = document.createElement('span');
      empty.className = 'hour-empty';
      empty.textContent = '—';
      tasksWrap.appendChild(empty);
    } else {
      tasksAtHour.forEach(task => {
        const item = document.createElement('div');
        item.className = 'hour-task';
        item.innerHTML = `
          ${task.completedAt ? `<span class="hour-time">${formatTime(task.completedAt)}</span>` : ''}
          <span class="task-text"></span>
          <span class="hour-task-board"></span>
          <button class="delete-btn" title="Excluir">&times;</button>
        `;
        item.querySelector('.task-text').textContent = task.text;
        item.querySelector('.hour-task-board').textContent = task.boardName;
        item.querySelector('.delete-btn').addEventListener('click', () => deleteTask(task.boardId, task.id, true));
        tasksWrap.appendChild(item);
      });
    }

    row.appendChild(tasksWrap);
    return row;
  }

  function renderDailyReport(all) {
    reportContent.innerHTML = '';

    if (all.length === 0) {
      reportContent.innerHTML = '<div class="empty-msg">Nenhuma tarefa concluída ainda.</div>';
      return;
    }

    const total = document.createElement('p');
    total.className = 'report-total';
    total.innerHTML = `Total de <strong>${all.length}</strong> tarefa${all.length === 1 ? '' : 's'} concluída${all.length === 1 ? '' : 's'} em todas as listas.`;
    reportContent.appendChild(total);

    const semHorario = all.filter(t => !t.completedAt);
    if (semHorario.length > 0) {
      reportContent.appendChild(buildReportBlock('Sem horário', semHorario));
    }

    for (let h = 0; h < 24; h++) {
      const tasksAtHour = all.filter(t => t.completedAt && new Date(t.completedAt).getHours() === h);
      if (tasksAtHour.length > 0) {
        reportContent.appendChild(buildReportBlock(formatHourLabel(h), tasksAtHour));
      }
    }
  }

  function buildReportBlock(label, tasksAtHour) {
    const block = document.createElement('div');
    block.className = 'report-hour-block';
    const names = tasksAtHour
      .map(t => t.completedAt ? `${t.text} (${formatTime(t.completedAt)} — ${t.boardName})` : `${t.text} (${t.boardName})`)
      .join(', ');
    block.innerHTML = `<span class="report-hour-label">${label}</span><span class="report-tasks"></span>`;
    block.querySelector('.report-tasks').textContent = names;
    return block;
  }

  function setDateSubtitle() {
    const meses = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];
    const hoje = new Date();
    const dia = hoje.getDate();
    const mes = meses[hoje.getMonth()];
    document.getElementById('date-subtitle').textContent = `dia ${dia} de ${mes}`;
  }

  // ---- Abas de navegação ----
  function initTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;

        tabBtns.forEach(b => b.classList.toggle('active', b === btn));
        tabPanels.forEach(panel => {
          panel.classList.toggle('active', panel.id === `tab-${target}`);
        });
      });
    });
  }

  // ---- Inicialização ----
  function init() {
    setDateSubtitle();
    loadFromStorage();
    renderAll();
    initTabs();
  }

  init();
</script>

</body>
</html>
