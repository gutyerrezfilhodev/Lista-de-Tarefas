  </div>

  <div class="tab-panel" id="tab-tasks">
    <div class="boards-column" id="boards-column"></div>
  </div>

  <div class="tab-panel" id="tab-fixed">
    <div class="fixed-column">
      <div class="fixed-panel">
        <h2>Tarefas fixas <span class="count" id="fixed-count">0</span></h2>
        <div class="mini-task-form">
          <input type="text" id="fixed-task-input" placeholder="Nome da tarefa fixa..." autocomplete="off">
          <button type="button" class="add-btn" id="fixed-task-add">Adicionar</button>
        </div>

        <div class="fixed-actions-bar">
          <div>
            <button type="button" class="select-all-btn" id="fixed-select-all">Selecionar todas</button>
            <span class="fixed-selection-info" id="fixed-selection-info"></span>
          </div>
          <div class="fixed-add-controls">
