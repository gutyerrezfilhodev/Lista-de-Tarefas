  <div class="tab-panel" id="tab-diary">
    <div class="diary-column">
      <div class="diary-panel">
        <h2>Diário de horários <span class="count" id="diary-count">0</span></h2>
        <div class="hour-timeline" id="hour-timeline"></div>
      </div>

      <div class="diary-panel">
        <h2>Relatório diário</h2>
        <div id="report-content"></div>
      </div>
