  </div>
</div>

<div class="modal-overlay" id="confirm-modal">
  <div class="modal-box">
    <p id="confirm-message">Essa tarefa foi realmente concluída?</p>
    <div class="modal-actions">
      <button class="modal-yes" id="confirm-yes">Sim</button>
      <button class="modal-no" id="confirm-no">Não</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="new-board-modal">
  <div class="modal-box">
    <p>Nome da nova lista de tarefas:</p>
    <input type="text" id="new-board-input" placeholder="Ex: Trabalho, Casa, Faculdade..." autocomplete="off">
    <div class="modal-actions">
      <button class="modal-yes" id="new-board-confirm">Criar</button>
      <button class="modal-no" id="new-board-cancel">Cancelar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="department-modal">
  <div class="modal-box">
    <p id="department-modal-title">Novo departamento</p>
    <input type="text" id="department-name-input" placeholder="Ex: Tecnologia, Livros, Freelas..." autocomplete="off">
    <div class="color-swatch-row" id="department-color-row"></div>
    <div class="modal-actions">
      <button class="modal-yes" id="department-confirm">Salvar</button>
      <button class="modal-no" id="department-cancel">Cancelar</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="social-modal">
  <div class="modal-box social-modal-box">
    <div class="social-modal-header">
      <h2 class="social-modal-title">Controle de Redes Sociais</h2>
      <button class="delete-btn" id="social-modal-close" title="Fechar">&times;</button>
    </div>
    <div class="mini-task-form social-add-form">
      <input type="text" id="social-name-input" placeholder="Rede social (ex: Instagram)..." autocomplete="off">
      <input type="number" id="social-usage-input" placeholder="Usos/dia" min="0" autocomplete="off">
      <button type="button" class="add-btn" id="social-add-btn">Adicionar</button>
    </div>
    <ul class="social-list" id="social-list"></ul>
  </div>
</div>

<script>
  const MESES = ['janeiro','fevereiro','março','abril','maio','junho','julho','agosto','setembro','outubro','novembro','dezembro'];

  // ---- Estado global ----
  let boards = [];
  let nextBoardId = 1;
  let expandedBoardId = null;

  // ---- Departamentos ----
  let departments = [];
  let nextDepartmentId = 1;
  let draggedDepartmentId = null;
  let editingDepartmentId = null;
  let pendingNewBoardDepartmentId = null;
  let selectedDepartmentColor = '#6ee7b7';
  const DEPARTMENT_COLOR_PRESETS = ['#6ee7b7', '#4f9fe8', '#e2685f', '#e0b93f', '#c084fc', '#f472b6', '#38bdf8', '#fb923c'];

  // ---- Tarefas fixas ----
  let fixedTasks = [];
  let nextFixedId = 1;
  let selectedFixedIds = new Set();

  // ---- Lista do dia (agenda por horário) ----
  let dailySchedule = {};
  let nextDailyId = 1;

  // ---- Nome do usuário (editável) e Controle de Redes Sociais ----
  let userName = 'Gutyerrez Filho';
  let socialNetworks = [];
  let nextSocialId = 1;

  // Controle de estado para a API de Drag and Drop
  let draggedTaskId = null;
  let draggedSourceBoardId = null;
  let draggedBoardId = null;

  // Drag and drop dentro da Lista do dia (entre horários)
  let draggedDailyTaskId = null;
  let draggedDailySourceHour = null;

  const PRIORITY_ORDER = ['red', 'yellow', 'blue', 'green', null];
  const PRIORITY_COLORS = { red: '#e2685f', yellow: '#e0b93f', blue: '#4f9fe8', green: '#5fd88a', null: '#4a4e58' };

  const STORAGE_KEY = 'lista-de-tarefas-gutyerrez';

  function escAttr(str) {
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/"/g, '&quot;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function saveToStorage() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ boards, nextBoardId, fixedTasks, nextFixedId, departments, nextDepartmentId, dailySchedule, nextDailyId, userName, socialNetworks, nextSocialId }));
    } catch (err) {
      console.error('Não foi possível salvar os dados:', err);
    }
  }

  function loadFromStorage() {
    try {
      const rawData = localStorage.getItem(STORAGE_KEY);
      if (!rawData) {
        boards = [{
          id: 1,
          name: 'Principal',
          tasks: [],
          doneTasks: [],
          nextId: 1,
          departmentId: null
        }];
        nextBoardId = 2;
        expandedBoardId = 1;
        fixedTasks = [];
        nextFixedId = 1;
        departments = [];
        nextDepartmentId = 1;
        dailySchedule = {};
        nextDailyId = 1;
        userName = 'Gutyerrez Filho';
        socialNetworks = [];
        nextSocialId = 1;
        return;
      }
      
      const data = JSON.parse(rawData);

      if (Array.isArray(data.boards) && data.boards.length > 0) {
        boards = data.boards;
        nextBoardId = typeof data.nextBoardId === 'number'
          ? data.nextBoardId
          : (Math.max(0, ...boards.map(b => b.id)) + 1);
      } else {
        boards = [{
          id: 1,
          name: 'Principal',
          tasks: Array.isArray(data.tasks) ? data.tasks : [],
          doneTasks: Array.isArray(data.doneTasks) ? data.doneTasks : [],
          nextId: typeof data.nextId === 'number' ? data.nextId : 1,
          departmentId: null
        }];
        nextBoardId = 2;
      }

      if (expandedBoardId === null && boards.length > 0) {
        expandedBoardId = boards[0].id;
      }

      boards.forEach(board => {
        if (board.departmentId === undefined) board.departmentId = null;
        (board.tasks || []).forEach(t => {
          t.editing = false;
          if (t.priority === undefined) t.priority = null;
        });
      });

      fixedTasks = Array.isArray(data.fixedTasks) ? data.fixedTasks : [];
      nextFixedId = typeof data.nextFixedId === 'number'
        ? data.nextFixedId
        : (fixedTasks.length > 0 ? Math.max(0, ...fixedTasks.map(t => t.id)) + 1 : 1);

      departments = Array.isArray(data.departments) ? data.departments : [];
      nextDepartmentId = typeof data.nextDepartmentId === 'number'
        ? data.nextDepartmentId
        : (departments.length > 0 ? Math.max(0, ...departments.map(d => d.id)) + 1 : 1);

      dailySchedule = (data.dailySchedule && typeof data.dailySchedule === 'object') ? data.dailySchedule : {};
      nextDailyId = typeof data.nextDailyId === 'number' ? data.nextDailyId : 1;

      Object.keys(dailySchedule).forEach(dateKey => {
        const daySchedule = dailySchedule[dateKey] || {};
        Object.keys(daySchedule).forEach(hourKey => {
          (daySchedule[hourKey] || []).forEach(t => {
            if (t.priority === undefined) t.priority = null;
            if (t.editing === undefined) t.editing = false;
            if (t.done === undefined) t.done = false;
          });
        });
      });

      userName = typeof data.userName === 'string' && data.userName.trim() ? data.userName : 'Gutyerrez Filho';

      socialNetworks = Array.isArray(data.socialNetworks) ? data.socialNetworks : [];
      socialNetworks.forEach(s => {
        if (s.usage === undefined) s.usage = 0;
        s.editing = false;
      });
      nextSocialId = typeof data.nextSocialId === 'number'
        ? data.nextSocialId
        : (socialNetworks.length > 0 ? Math.max(0, ...socialNetworks.map(s => s.id)) + 1 : 1);
    } catch (err) {
      console.error('Não foi possível carregar as listas salvas:', err);
      boards = [{ id: 1, name: 'Principal', tasks: [], doneTasks: [], nextId: 1, departmentId: null }];
      nextBoardId = 2;
      expandedBoardId = 1;
      fixedTasks = [];
      nextFixedId = 1;
      departments = [];
      nextDepartmentId = 1;
      dailySchedule = {};
      nextDailyId = 1;
      userName = 'Gutyerrez Filho';
      socialNetworks = [];
      nextSocialId = 1;
    }
  }

  const boardsColumn = document.getElementById('boards-column');
  const hourTimeline = document.getElementById('hour-timeline');
  const diaryCount = document.getElementById('diary-count');
  const reportContent = document.getElementById('report-content');

  const fixedListEl = document.getElementById('fixed-list');
  const fixedCountEl = document.getElementById('fixed-count');
  const fixedTaskInput = document.getElementById('fixed-task-input');
  const fixedTaskAddBtn = document.getElementById('fixed-task-add');
  const fixedSelectAllBtn = document.getElementById('fixed-select-all');
  const fixedSelectionInfo = document.getElementById('fixed-selection-info');
  const fixedApplySelect = document.getElementById('fixed-apply-select');
  const fixedApplyBtn = document.getElementById('fixed-apply-btn');

  const dailyTitleEl = document.getElementById('daily-title');
  const dailyHourListEl = document.getElementById('daily-hour-list');

  function getBoard(id) {
    return boards.find(b => b.id === id);
  }

  // ---- Nome do usuário editável ----
  function renderHeaderName() {
    const wrap = document.getElementById('user-name-wrap');
    if (!wrap) return;
    wrap.innerHTML = `<span class="user-name-text" id="user-name-text"></span><button class="rename-btn user-name-edit-btn" id="user-name-edit-btn" title="Editar nome">&#9998;</button>`;
    document.getElementById('user-name-text').textContent = userName;
    document.getElementById('user-name-edit-btn').addEventListener('click', startRenameUser);
  }

  function startRenameUser() {
    const textEl = document.getElementById('user-name-text');
    if (!textEl) return;
    const inputEl = document.createElement('input');
    inputEl.type = 'text';
    inputEl.className = 'user-name-input';
    inputEl.value = userName;
    textEl.replaceWith(inputEl);
    inputEl.focus();
    inputEl.select();

    function commit() {
      const newName = inputEl.value.trim();
      if (newName) {
        userName = newName;
        saveToStorage();
      }
      renderHeaderName();
    }

    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') commit();
      if (e.key === 'Escape') renderHeaderName();
    });
    inputEl.addEventListener('blur', commit);
  }

  // ---- Controle de Redes Sociais ----
  const socialModal = document.getElementById('social-modal');
  const socialCardBtn = document.getElementById('social-card-btn');
  const socialModalClose = document.getElementById('social-modal-close');
  const socialNameInput = document.getElementById('social-name-input');
  const socialUsageInput = document.getElementById('social-usage-input');
  const socialAddBtn = document.getElementById('social-add-btn');
  const socialListEl = document.getElementById('social-list');
  const socialCardCountEl = document.getElementById('social-card-count');

  function openSocialModal() {
    renderSocial();
    socialModal.classList.add('open');
    setTimeout(() => socialNameInput.focus(), 50);
  }

  function closeSocialModal() {
    socialModal.classList.remove('open');
  }

  socialCardBtn.addEventListener('click', openSocialModal);
  socialModalClose.addEventListener('click', closeSocialModal);
  socialModal.addEventListener('click', (e) => {
    if (e.target === socialModal) closeSocialModal();
  });

  function submitSocial() {
    addSocialNetwork(socialNameInput.value, socialUsageInput.value);
    socialNameInput.value = '';
    socialUsageInput.value = '';
    socialNameInput.focus();
  }
  socialAddBtn.addEventListener('click', submitSocial);
  socialNameInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); submitSocial(); }
  });
  socialUsageInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); submitSocial(); }
  });

  function addSocialNetwork(name, usage) {
    const trimmed = name.trim();
    if (!trimmed) return;
    const usageNum = Math.max(0, parseInt(usage, 10) || 0);
    socialNetworks.push({ id: nextSocialId++, name: trimmed, usage: usageNum, editing: false });
    saveToStorage();
    renderSocial();
  }

  function deleteSocialNetwork(id) {
    socialNetworks = socialNetworks.filter(s => s.id !== id);
    saveToStorage();
    renderSocial();
  }

  function updateSocialUsage(id, value) {
    const item = socialNetworks.find(s => s.id === id);
    if (!item) return;
    item.usage = Math.max(0, parseInt(value, 10) || 0);
    saveToStorage();
    renderSocial();
  }

  function startSocialEdit(id) {
    const item = socialNetworks.find(s => s.id === id);
    if (!item) return;
    item.editing = true;
    renderSocial();
  }

  function saveSocialEdit(id, newName) {
    const item = socialNetworks.find(s => s.id === id);
    if (!item) return;
    const trimmed = newName.trim();
    if (trimmed) item.name = trimmed;
    item.editing = false;
    saveToStorage();
    renderSocial();
  }

  function renderSocial() {
    if (socialCardCountEl) socialCardCountEl.textContent = socialNetworks.length;
    if (!socialListEl) return;

    socialListEl.innerHTML = '';

    if (socialNetworks.length === 0) {
      socialListEl.innerHTML = '<li style="all:unset; cursor:default;"><div class="empty-msg" style="width:100%">Nenhuma rede social cadastrada.</div></li>';
      return;
    }

    socialNetworks.forEach(item => {
      const li = document.createElement('li');
      li.className = 'social-item';

      if (item.editing) {
        li.innerHTML = `
          <input type="text" class="edit-input" value="${escAttr(item.name)}">
          <button class="edit-btn" title="Salvar">&#10003;</button>
        `;
        const editInput = li.querySelector('.edit-input');
        li.querySelector('.edit-btn').addEventListener('click', () => saveSocialEdit(item.id, editInput.value));
        editInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') saveSocialEdit(item.id, editInput.value);
          if (e.key === 'Escape') { item.editing = false; renderSocial(); }
        });
        socialListEl.appendChild(li);
        editInput.focus();
        editInput.select();
        return;
      }

      li.innerHTML = `
        <span class="social-name"></span>
        <input type="number" class="social-usage-input-inline" min="0" value="${item.usage}">
        <span class="social-usage-label">usos/dia</span>
        <button class="edit-btn" title="Editar">&#9998;</button>
        <button class="delete-btn" title="Excluir">&times;</button>
      `;
      li.querySelector('.social-name').textContent = item.name;
      li.querySelector('.social-usage-input-inline').addEventListener('change', (e) => updateSocialUsage(item.id, e.target.value));
      li.querySelector('.edit-btn').addEventListener('click', () => startSocialEdit(item.id));
      li.querySelector('.delete-btn').addEventListener('click', () => deleteSocialNetwork(item.id));
      socialListEl.appendChild(li);
    });
  }

  // ---- Modais ----
  const confirmModal = document.getElementById('confirm-modal');
  const confirmMessage = document.getElementById('confirm-message');
  const confirmYes = document.getElementById('confirm-yes');
  const confirmNo = document.getElementById('confirm-no');
  let confirmCallback = null;

  function showConfirm(message, onYes) {
    confirmMessage.textContent = message;
    confirmCallback = onYes;
    confirmModal.classList.add('open');
  }

  function closeConfirmModal() {
    confirmCallback = null;
    confirmModal.classList.remove('open');
  }

  confirmYes.addEventListener('click', () => {
    const cb = confirmCallback;
    closeConfirmModal();
    if (cb) cb();
  });
  confirmNo.addEventListener('click', closeConfirmModal);
  confirmModal.addEventListener('click', (e) => {
    if (e.target === confirmModal) closeConfirmModal();
  });

  const newBoardModal = document.getElementById('new-board-modal');
  const newBoardInput = document.getElementById('new-board-input');

  function openNewBoardModal(departmentId = null) {
    pendingNewBoardDepartmentId = departmentId;
    newBoardInput.value = '';
    newBoardModal.classList.add('open');
    setTimeout(() => newBoardInput.focus(), 50);
  }

  function closeNewBoardModal() {
    newBoardModal.classList.remove('open');
  }

  function createBoard() {
    const name = newBoardInput.value.trim();
    if (!name) { newBoardInput.focus(); return; }
    const board = { id: nextBoardId++, name, tasks: [], doneTasks: [], nextId: 1, departmentId: pendingNewBoardDepartmentId };
    boards.push(board);
    expandedBoardId = board.id;
    pendingNewBoardDepartmentId = null;
    saveToStorage();
    closeNewBoardModal();
    renderAll();
  }

  document.getElementById('new-board-confirm').addEventListener('click', createBoard);
  document.getElementById('new-board-cancel').addEventListener('click', closeNewBoardModal);
  newBoardInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); createBoard(); }
    if (e.key === 'Escape') closeNewBoardModal();
  });
  newBoardModal.addEventListener('click', (e) => {
    if (e.target === newBoardModal) closeNewBoardModal();
  });

  function confirmDeleteBoard(id) {
    const board = getBoard(id);
    if (!board) return;
    showConfirm(`Excluir a lista "${board.name}"? Essa ação não pode ser desfeita.`, () => {
      boards = boards.filter(b => b.id !== id);
      if (expandedBoardId === id) {
        expandedBoardId = boards.length > 0 ? boards[0].id : null;
      }
      saveToStorage();
      renderAll();
    });
  }

  // ---- Modal de Departamentos ----
  const departmentModal = document.getElementById('department-modal');
  const departmentNameInput = document.getElementById('department-name-input');
  const departmentModalTitle = document.getElementById('department-modal-title');
  const departmentColorRow = document.getElementById('department-color-row');

  function openDepartmentModal(dept = null) {
    editingDepartmentId = dept ? dept.id : null;
    departmentModalTitle.textContent = dept ? 'Editar departamento' : 'Novo departamento';
    departmentNameInput.value = dept ? dept.name : '';
    selectedDepartmentColor = dept ? dept.color : DEPARTMENT_COLOR_PRESETS[0];
    renderColorSwatches();
    departmentModal.classList.add('open');
    setTimeout(() => departmentNameInput.focus(), 50);
  }

  function closeDepartmentModal() {
    departmentModal.classList.remove('open');
    editingDepartmentId = null;
  }

  function renderColorSwatches() {
    departmentColorRow.innerHTML = '';
    DEPARTMENT_COLOR_PRESETS.forEach(color => {
      const swatch = document.createElement('button');
      swatch.type = 'button';
      swatch.className = 'color-swatch' + (color === selectedDepartmentColor ? ' selected' : '');
      swatch.style.background = color;
      swatch.title = color;
      swatch.addEventListener('click', () => {
        selectedDepartmentColor = color;
        renderColorSwatches();
      });
      departmentColorRow.appendChild(swatch);
    });
  }

  function saveDepartmentModal() {
    const name = departmentNameInput.value.trim();
    if (!name) { departmentNameInput.focus(); return; }

    if (editingDepartmentId !== null) {
      const dept = departments.find(d => d.id === editingDepartmentId);
      if (dept) {
        dept.name = name;
        dept.color = selectedDepartmentColor;
      }
    } else {
      departments.push({ id: nextDepartmentId++, name, color: selectedDepartmentColor });
    }

    saveToStorage();
    closeDepartmentModal();
    renderBoardsColumn();
  }

  document.getElementById('department-confirm').addEventListener('click', saveDepartmentModal);
  document.getElementById('department-cancel').addEventListener('click', closeDepartmentModal);
  departmentNameInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { e.preventDefault(); saveDepartmentModal(); }
    if (e.key === 'Escape') closeDepartmentModal();
  });
  departmentModal.addEventListener('click', (e) => {
    if (e.target === departmentModal) closeDepartmentModal();
  });

  function confirmDeleteDepartment(id) {
    const dept = departments.find(d => d.id === id);
    if (!dept) return;
    showConfirm(`Excluir o departamento "${dept.name}"? As listas dele irão para "Sem departamento".`, () => {
      boards.forEach(b => { if (b.departmentId === id) b.departmentId = null; });
      departments = departments.filter(d => d.id !== id);
      saveToStorage();
      renderBoardsColumn();
    });
  }

  function reorderDepartment(sourceId, targetId, insertBefore) {
    if (sourceId === targetId) return;
    const sourceIndex = departments.findIndex(d => d.id === sourceId);
    if (sourceIndex === -1) return;
    const [moved] = departments.splice(sourceIndex, 1);

    const targetIndex = departments.findIndex(d => d.id === targetId);
    if (targetIndex === -1) {
      departments.push(moved);
    } else {
      const insertIndex = insertBefore ? targetIndex : targetIndex + 1;
      departments.splice(insertIndex, 0, moved);
    }

    saveToStorage();
    renderBoardsColumn();
  }

  function moveBoardToDepartment(boardId, deptId) {
    const idx = boards.findIndex(b => b.id === boardId);
    if (idx === -1) return;
    const [board] = boards.splice(idx, 1);
    board.departmentId = deptId || null;

    let insertAt = boards.length;
    for (let i = boards.length - 1; i >= 0; i--) {
      if ((boards[i].departmentId || null) === (deptId || null)) {
        insertAt = i + 1;
        break;
      }
    }
    boards.splice(insertAt, 0, board);

    saveToStorage();
    renderBoardsColumn();
  }

  function buildDepartmentOptionsHTML(selectedDeptId) {
    let html = `<option value="" ${!selectedDeptId ? 'selected' : ''}>Sem departamento</option>`;
    departments.forEach(d => {
      const sel = String(d.id) === String(selectedDeptId) ? 'selected' : '';
      html += `<option value="${d.id}" ${sel}>${escAttr(d.name)}</option>`;
    });
    return html;
  }

  // ---- Operações com Tarefas ----
  function addTask(boardId, text) {
    const board = getBoard(boardId);
    if (!board || !text.trim()) return;
    board.tasks.push({ id: board.nextId++, text: text.trim(), priority: null, editing: false });
    saveToStorage();
    renderAll();
  }

  function askComplete(boardId, taskId) {
    showConfirm('Essa tarefa foi realmente concluída?', () => {
      const board = getBoard(boardId);
      if (!board) return;
      const idx = board.tasks.findIndex(t => t.id === taskId);
      if (idx !== -1) {
        const [task] = board.tasks.splice(idx, 1);
        task.completedAt = new Date().toISOString();
        board.doneTasks.push(task);
        saveToStorage();
        renderAll();
      }
    });
  }

  function sortBoardTasks(board) {
    board.tasks.sort((a, b) => PRIORITY_ORDER.indexOf(a.priority || null) - PRIORITY_ORDER.indexOf(b.priority || null));
  }

  function setPriority(boardId, taskId, value) {
    const board = getBoard(boardId);
    if (!board) return;
    const task = board.tasks.find(t => t.id === taskId);
    if (!task) return;
    task.priority = value || null;
    sortBoardTasks(board);
    saveToStorage();
    renderAll();
  }

  function moveTaskToBoard(sourceBoardId, targetBoardId, taskId, targetIndex = null) {
    const sourceBoard = getBoard(sourceBoardId);
    const targetBoard = getBoard(targetBoardId);
    if (!sourceBoard || !targetBoard) return;

    const taskIndex = sourceBoard.tasks.findIndex(t => t.id === taskId);
    if (taskIndex === -1) return;

    const [task] = sourceBoard.tasks.splice(taskIndex, 1);
    
    if (sourceBoardId !== targetBoardId) {
      task.id = targetBoard.nextId++;
    }

    if (targetIndex !== null && targetIndex >= 0) {
      targetBoard.tasks.splice(targetIndex, 0, task);
    } else {
      targetBoard.tasks.push(task);
    }

    saveToStorage();
    renderAll();
  }

  function moveTask(boardId, taskId, direction) {
    const board = getBoard(boardId);
    if (!board) return;
    const idx = board.tasks.findIndex(t => t.id === taskId);
    if (idx === -1) return;
    const current = board.tasks[idx].priority || null;

    if (direction === 'up') {
      const prevIdx = idx - 1;
      if (prevIdx >= 0 && (board.tasks[prevIdx].priority || null) === current) {
        [board.tasks[prevIdx], board.tasks[idx]] = [board.tasks[idx], board.tasks[prevIdx]];
      }
    } else {
      const nextIdx = idx + 1;
      if (nextIdx < board.tasks.length && (board.tasks[nextIdx].priority || null) === current) {
        [board.tasks[idx], board.tasks[nextIdx]] = [board.tasks[nextIdx], board.tasks[idx]];
      }
    }
    saveToStorage();
    renderAll();
  }

  function moveBoard(boardId, direction) {
    const idx = boards.findIndex(b => b.id === boardId);
    if (idx === -1) return;
    const deptId = boards[idx].departmentId || null;

    if (direction === 'up') {
      for (let i = idx - 1; i >= 0; i--) {
        if ((boards[i].departmentId || null) === deptId) {
          [boards[i], boards[idx]] = [boards[idx], boards[i]];
          break;
        }
      }
    } else {
      for (let i = idx + 1; i < boards.length; i++) {
        if ((boards[i].departmentId || null) === deptId) {
          [boards[idx], boards[i]] = [boards[i], boards[idx]];
          break;
        }
      }
    }
    saveToStorage();
    renderBoardsColumn();
  }

  function reorderBoard(sourceBoardId, targetBoardId, insertBefore) {
    if (sourceBoardId === targetBoardId) return;
    const targetBoardRef = getBoard(targetBoardId);
    if (!targetBoardRef) return;
    const targetDeptId = targetBoardRef.departmentId || null;

    const sourceIndex = boards.findIndex(b => b.id === sourceBoardId);
    if (sourceIndex === -1) return;
    const [movedBoard] = boards.splice(sourceIndex, 1);
    movedBoard.departmentId = targetDeptId;

    const targetIndex = boards.findIndex(b => b.id === targetBoardId);
    if (targetIndex === -1) {
      boards.push(movedBoard);
    } else {
      const insertIndex = insertBefore ? targetIndex : targetIndex + 1;
      boards.splice(insertIndex, 0, movedBoard);
    }

    saveToStorage();
    renderBoardsColumn();
  }

  function startEdit(boardId, taskId) {
    const board = getBoard(boardId);
    if (!board) return;
    const task = board.tasks.find(t => t.id === taskId);
    if (!task) return;
    task.editing = true;
    renderAll();
  }

  function saveEdit(boardId, taskId, newText) {
    const board = getBoard(boardId);
    if (!board) return;
    const task = board.tasks.find(t => t.id === taskId);
    if (!task) return;
    const trimmed = newText.trim();
    if (trimmed) task.text = trimmed;
    task.editing = false;
    saveToStorage();
    renderAll();
  }

  function deleteTask(boardId, taskId, fromDone) {
    const board = getBoard(boardId);
    if (!board) return;
    if (fromDone) {
      board.doneTasks = board.doneTasks.filter(t => t.id !== taskId);
    } else {
      board.tasks = board.tasks.filter(t => t.id !== taskId);
    }
    saveToStorage();
    renderAll();
  }

  // ---- Operações com Tarefas Fixas ----
  function addFixedTask(text) {
    const trimmed = text.trim();
    if (!trimmed) return;
    fixedTasks.push({ id: nextFixedId++, text: trimmed });
    saveToStorage();
    renderFixed();
  }

  function deleteFixedTask(id) {
    fixedTasks = fixedTasks.filter(t => t.id !== id);
    selectedFixedIds.delete(id);
    saveToStorage();
    renderFixed();
  }

  function toggleFixedSelection(id, checked) {
    if (checked) {
      selectedFixedIds.add(id);
    } else {
      selectedFixedIds.delete(id);
    }
    updateFixedActionsBar();
  }

  function toggleSelectAllFixed() {
    const allSelected = fixedTasks.length > 0 && fixedTasks.every(t => selectedFixedIds.has(t.id));
    if (allSelected) {
      selectedFixedIds.clear();
    } else {
      fixedTasks.forEach(t => selectedFixedIds.add(t.id));
    }
    renderFixed();
  }

  function applySelectedFixedTasks() {
    const targetBoardId = parseInt(fixedApplySelect.value, 10);
    if (!targetBoardId || selectedFixedIds.size === 0) return;
    const board = getBoard(targetBoardId);
    if (!board) return;

    fixedTasks.forEach(ft => {
      if (selectedFixedIds.has(ft.id)) {
        board.tasks.push({ id: board.nextId++, text: ft.text, priority: null, editing: false });
      }
    });

    selectedFixedIds.clear();
    saveToStorage();
    renderAll();
  }

  // ---- Operações da Lista do dia ----
  function getTodayKey() {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function ensureTodaySchedule() {
    const key = getTodayKey();
    if (!dailySchedule[key]) {
      dailySchedule[key] = {};
    }
    return dailySchedule[key];
  }

  const MAX_TASKS_PER_HOUR = 6;

  function addDailyTask(hour, text) {
    const trimmed = text.trim();
    if (!trimmed) return;
    const schedule = ensureTodaySchedule();
    if (!schedule[hour]) schedule[hour] = [];
    if (schedule[hour].length >= MAX_TASKS_PER_HOUR) return;
    schedule[hour].push({ id: nextDailyId++, text: trimmed, priority: null, done: false, editing: false });
    saveToStorage();
    renderDailyList();
  }

  function buildHourOptionsHTML() {
    const schedule = dailySchedule[getTodayKey()] || {};
    let html = '<option value="" disabled selected>Enviar p/ hora</option>';
    for (let h = 0; h < 24; h++) {
      const count = (schedule[h] || []).length;
      const full = count >= MAX_TASKS_PER_HOUR;
      html += `<option value="${h}" ${full ? 'disabled' : ''}>${h}h${full ? ' (cheio)' : ` (${count}/${MAX_TASKS_PER_HOUR})`}</option>`;
    }
    return html;
  }

  function buildDailyMoveHourOptionsHTML(currentHour) {
    const schedule = dailySchedule[getTodayKey()] || {};
    let html = '<option value="" disabled selected>Mover p/...</option>';
    for (let h = 0; h < 24; h++) {
      if (h === currentHour) continue;
      const count = (schedule[h] || []).length;
      const full = count >= MAX_TASKS_PER_HOUR;
      html += `<option value="${h}" ${full ? 'disabled' : ''}>${h}h${full ? ' (cheio)' : ''}</option>`;
    }
    return html;
  }

  function moveTaskToHour(boardId, taskId, hour) {
    const board = getBoard(boardId);
    if (!board) return;
    const schedule = ensureTodaySchedule();
    if (!schedule[hour]) schedule[hour] = [];
    if (schedule[hour].length >= MAX_TASKS_PER_HOUR) return;

    const taskIdx = board.tasks.findIndex(t => t.id === taskId);
    if (taskIdx === -1) return;

    const [task] = board.tasks.splice(taskIdx, 1);
    schedule[hour].push({ id: nextDailyId++, text: task.text, priority: null, done: false, editing: false });
    saveToStorage();
    renderAll();
  }

  function moveDailyTaskToHour(fromHour, toHour, taskId, targetIndex = null) {
    const schedule = ensureTodaySchedule();
    const fromArr = schedule[fromHour] || [];
    const idx = fromArr.findIndex(t => t.id === taskId);
    if (idx === -1) return;

    if (!schedule[toHour]) schedule[toHour] = [];
    if (fromHour !== toHour && schedule[toHour].length >= MAX_TASKS_PER_HOUR) return;

    const [task] = fromArr.splice(idx, 1);
    schedule[fromHour] = fromArr;

    if (targetIndex !== null && targetIndex >= 0) {
      schedule[toHour].splice(targetIndex, 0, task);
    } else {
      schedule[toHour].push(task);
    }

    saveToStorage();
    renderDailyList();
  }

  function buildBoardMoveOptionsHTML() {
    let html = '<option value="" disabled selected>Mover p/ lista...</option>';
    boards.forEach(b => {
      html += `<option value="${b.id}">${escAttr(b.name)}</option>`;
    });
    return html;
  }

  function moveDailyTaskToBoard(hour, taskId, targetBoardId) {
    const board = getBoard(targetBoardId);
    if (!board) return;
    const schedule = ensureTodaySchedule();
    const arr = schedule[hour] || [];
    const idx = arr.findIndex(t => t.id === taskId);
    if (idx === -1) return;

    const [task] = arr.splice(idx, 1);
    board.tasks.push({ id: board.nextId++, text: task.text, priority: task.priority || null, editing: false });
    saveToStorage();
    renderAll();
  }

  function sortDailyTasks(hour) {
    const schedule = ensureTodaySchedule();
    if (!schedule[hour]) return;
    schedule[hour].sort((a, b) => PRIORITY_ORDER.indexOf(a.priority || null) - PRIORITY_ORDER.indexOf(b.priority || null));
  }

  function setDailyPriority(hour, id, value) {
    const schedule = ensureTodaySchedule();
    const arr = schedule[hour] || [];
    const task = arr.find(t => t.id === id);
    if (!task) return;
    task.priority = value || null;
    sortDailyTasks(hour);
    saveToStorage();
    renderDailyList();
  }

  function moveDailyTask(hour, id, direction) {
    const schedule = ensureTodaySchedule();
    const arr = schedule[hour] || [];
    const idx = arr.findIndex(t => t.id === id);
    if (idx === -1) return;
    const current = arr[idx].priority || null;

    if (direction === 'up') {
      const prevIdx = idx - 1;
      if (prevIdx >= 0 && (arr[prevIdx].priority || null) === current) {
        [arr[prevIdx], arr[idx]] = [arr[idx], arr[prevIdx]];
      }
    } else {
      const nextIdx = idx + 1;
      if (nextIdx < arr.length && (arr[nextIdx].priority || null) === current) {
        [arr[idx], arr[nextIdx]] = [arr[nextIdx], arr[idx]];
      }
    }
    saveToStorage();
    renderDailyList();
  }

  function startDailyEdit(hour, id) {
    const schedule = ensureTodaySchedule();
    const task = (schedule[hour] || []).find(t => t.id === id);
    if (!task) return;
    task.editing = true;
    renderDailyList();
  }

  function saveDailyEdit(hour, id, newText) {
    const schedule = ensureTodaySchedule();
    const task = (schedule[hour] || []).find(t => t.id === id);
    if (!task) return;
    const trimmed = newText.trim();
    if (trimmed) task.text = trimmed;
    task.editing = false;
    saveToStorage();
    renderDailyList();
  }

  function toggleDailyTaskDone(hour, id) {
    const schedule = ensureTodaySchedule();
    const arr = schedule[hour] || [];
    const task = arr.find(t => t.id === id);
    if (!task) return;
    if (!task.done) {
      showConfirm('Essa tarefa foi realmente concluída?', () => {
        task.done = true;
        saveToStorage();
        renderDailyList();
      });
    } else {
      task.done = false;
      saveToStorage();
      renderDailyList();
    }
  }

  function deleteDailyTask(hour, id) {
    const schedule = ensureTodaySchedule();
    if (schedule[hour]) {
      schedule[hour] = schedule[hour].filter(t => t.id !== id);
    }
    saveToStorage();
    renderDailyList();
  }

  function buildDailyHourRow(hour, tasksArr) {
    const row = document.createElement('div');
    row.className = 'daily-hour-row' + (tasksArr.length > 0 ? ' has-tasks' : '');

    const left = document.createElement('div');
    left.className = 'daily-hour-left';
    const label = document.createElement('span');
    label.className = 'hour-label';
    label.textContent = `${hour}h`;
    left.appendChild(label);
    row.appendChild(left);

    const body = document.createElement('div');
    body.className = 'daily-hour-body';

    body.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (draggedDailyTaskId !== null) {
        body.classList.add('drag-over');
      }
    });

    body.addEventListener('dragleave', (e) => {
      if (!body.contains(e.relatedTarget)) {
        body.classList.remove('drag-over');
      }
    });

    body.addEventListener('drop', (e) => {
      e.preventDefault();
      body.classList.remove('drag-over');
      if (draggedDailyTaskId !== null && draggedDailySourceHour !== null && !e.target.closest('li')) {
        moveDailyTaskToHour(draggedDailySourceHour, hour, draggedDailyTaskId);
      }
    });

    const list = document.createElement('ul');
    list.className = 'daily-task-list';

    tasksArr.forEach((task, i) => {
      const li = document.createElement('li');
      li.dataset.taskId = task.id;
      li.dataset.hour = hour;

      const priority = task.priority || null;
      if (priority) li.classList.add('pri-' + priority);
      if (task.done) li.classList.add('task-done');

      const isFirstInGroup = i === 0 || (tasksArr[i - 1].priority || null) !== priority;
      const isLastInGroup = i === tasksArr.length - 1 || (tasksArr[i + 1].priority || null) !== priority;

      if (task.editing) {
        li.draggable = false;
        li.innerHTML = `
          <div class="task-top-row">
            <div class="task-top-left">
              <span class="index">${i + 1}</span>
            </div>
            <div class="task-top-right">
              <button class="edit-btn" title="Salvar">&#10003;</button>
            </div>
          </div>
          <input type="text" class="edit-input" value="${escAttr(task.text)}">
        `;
        const editInput = li.querySelector('.edit-input');
        li.querySelector('.edit-btn').addEventListener('click', () => saveDailyEdit(hour, task.id, editInput.value));
        editInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') saveDailyEdit(hour, task.id, editInput.value);
          if (e.key === 'Escape') { task.editing = false; renderDailyList(); }
        });
        list.appendChild(li);
        editInput.focus();
        editInput.select();
        return;
      }

      li.draggable = true;

      li.addEventListener('dragstart', (e) => {
        draggedDailyTaskId = task.id;
        draggedDailySourceHour = hour;
        li.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', JSON.stringify({ hour, taskId: task.id }));
      });

      li.addEventListener('dragend', () => {
        draggedDailyTaskId = null;
        draggedDailySourceHour = null;
        li.classList.remove('dragging');
        document.querySelectorAll('.drag-over-item').forEach(el => el.classList.remove('drag-over-item'));
        document.querySelectorAll('.daily-hour-body.drag-over').forEach(el => el.classList.remove('drag-over'));
      });

      li.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (draggedDailyTaskId !== null && draggedDailyTaskId !== task.id) {
          li.classList.add('drag-over-item');
        }
      });

      li.addEventListener('dragleave', () => {
        li.classList.remove('drag-over-item');
      });

      li.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        li.classList.remove('drag-over-item');
        if (draggedDailyTaskId !== null && draggedDailySourceHour !== null) {
          moveDailyTaskToHour(draggedDailySourceHour, hour, draggedDailyTaskId, i);
        }
      });

      li.innerHTML = `
        <div class="task-top-row">
          <div class="task-top-left">
            <span class="drag-handle" title="Arrastar tarefa">&#9776;</span>
            <span class="index">${i + 1}</span>
            <div class="move-group">
              <button class="move-btn daily-move-up" title="Mover para cima" ${isFirstInGroup ? 'disabled' : ''}>&#9650;</button>
              <button class="move-btn daily-move-down" title="Mover para baixo" ${isLastInGroup ? 'disabled' : ''}>&#9660;</button>
            </div>
            <button class="check-btn" title="Marcar como concluída"></button>
          </div>
          <div class="task-top-right">
            <select class="move-board-select" title="Mover para uma lista">
              ${buildBoardMoveOptionsHTML()}
            </select>
            <select class="daily-hour-select" title="Mover para outro horário">
              ${buildDailyMoveHourOptionsHTML(hour)}
            </select>
            <select class="priority-select" title="Classificar prioridade">
              <option value="">Sem cor</option>
              <option value="red">Urgente</option>
              <option value="yellow">Média</option>
              <option value="blue">Baixa</option>
              <option value="green">Adiável</option>
            </select>
            <button class="edit-btn" title="Editar">&#9998;</button>
            <button class="delete-btn" title="Excluir">&times;</button>
          </div>
        </div>
        <span class="task-text"></span>
      `;
      li.querySelector('.task-text').textContent = task.text;

      const select = li.querySelector('.priority-select');
      select.value = priority || '';
      select.style.background = PRIORITY_COLORS[priority || null];
      select.addEventListener('change', (e) => setDailyPriority(hour, task.id, e.target.value));

      li.querySelector('.move-board-select').addEventListener('change', (e) => {
        const targetBoardId = parseInt(e.target.value, 10);
        if (targetBoardId) {
          moveDailyTaskToBoard(hour, task.id, targetBoardId);
        }
      });

      li.querySelector('.daily-hour-select').addEventListener('change', (e) => {
        const targetHour = parseInt(e.target.value, 10);
        if (!Number.isNaN(targetHour)) {
          moveDailyTaskToHour(hour, targetHour, task.id);
        }
      });

      li.querySelector('.daily-move-up').addEventListener('click', () => moveDailyTask(hour, task.id, 'up'));
      li.querySelector('.daily-move-down').addEventListener('click', () => moveDailyTask(hour, task.id, 'down'));
      li.querySelector('.check-btn').addEventListener('click', () => toggleDailyTaskDone(hour, task.id));
      li.querySelector('.edit-btn').addEventListener('click', () => startDailyEdit(hour, task.id));
      li.querySelector('.delete-btn').addEventListener('click', () => deleteDailyTask(hour, task.id));

      list.appendChild(li);
    });

    body.appendChild(list);

    if (tasksArr.length >= MAX_TASKS_PER_HOUR) {
      const fullMsg = document.createElement('div');
      fullMsg.className = 'daily-hour-full-msg';
      fullMsg.textContent = `Limite de ${MAX_TASKS_PER_HOUR} tarefas atingido para este horário.`;
      body.appendChild(fullMsg);
    } else {
      const form = document.createElement('div');
      form.className = 'daily-add-form';
      form.innerHTML = `
        <input type="text" class="daily-task-input" placeholder="Agendar algo para ${hour}h..." autocomplete="off">
        <button type="button" class="add-btn">+</button>
      `;
      const input = form.querySelector('.daily-task-input');
      const addBtn = form.querySelector('.add-btn');
      function submit() {
        addDailyTask(hour, input.value);
        input.value = '';
        input.focus();
      }
      addBtn.addEventListener('click', submit);
      input.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') { e.preventDefault(); submit(); }
      });
      body.appendChild(form);
    }

    row.appendChild(body);
    return row;
  }

  function renderDailyList() {
    const key = getTodayKey();
    const schedule = dailySchedule[key] || {};

    const d = new Date();
    const dayNum = d.getDate();
    const monthName = MESES[d.getMonth()];
    dailyTitleEl.textContent = `Lista do dia - ${dayNum} de ${monthName}`;

    dailyHourListEl.innerHTML = '';
    for (let h = 0; h < 24; h++) {
      const tasksArr = schedule[h] || [];
      dailyHourListEl.appendChild(buildDailyHourRow(h, tasksArr));
    }
  }

  // ---- Renderização ----
  function renderAll() {
    renderDailyList();
    renderBoardsColumn();
    renderFixed();
    renderDiary();
    renderSocial();
  }

  function renderBoardsColumn() {
    boardsColumn.innerHTML = '';

    const ungrouped = boards.filter(b => !b.departmentId);
    boardsColumn.appendChild(buildDepartmentSection(null, ungrouped));

    departments.forEach(dept => {
      const deptBoards = boards.filter(b => b.departmentId === dept.id);
      boardsColumn.appendChild(buildDepartmentSection(dept, deptBoards));
    });

    const newDeptCard = document.createElement('div');
    newDeptCard.className = 'new-board-card';
    newDeptCard.innerHTML = '<span>+</span><span>Criar Departamento</span>';
    newDeptCard.addEventListener('click', () => openDepartmentModal());
    boardsColumn.appendChild(newDeptCard);
  }

  function buildDepartmentSection(dept, deptBoards) {
    const section = document.createElement('div');
    section.className = 'department-section';
    section.dataset.departmentId = dept ? dept.id : 'none';
    if (dept) {
      section.style.setProperty('--dept-color', dept.color);
    }

    // EVENTOS DE DRAG AND DROP NA SEÇÃO DO DEPARTAMENTO
    section.addEventListener('dragover', (e) => {
      e.preventDefault();
      if (dept && draggedDepartmentId !== null) {
        if (draggedDepartmentId !== dept.id) {
          const rect = section.getBoundingClientRect();
          const isTopHalf = (e.clientY - rect.top) < rect.height / 2;
          section.classList.toggle('dept-insert-before', isTopHalf);
          section.classList.toggle('dept-insert-after', !isTopHalf);
        }
      } else if (draggedBoardId !== null) {
        section.classList.add('department-drag-over');
      }
    });

    section.addEventListener('dragleave', (e) => {
      if (!section.contains(e.relatedTarget)) {
        section.classList.remove('department-drag-over', 'dept-insert-before', 'dept-insert-after');
      }
    });

    section.addEventListener('drop', (e) => {
      e.preventDefault();
      const insertBefore = section.classList.contains('dept-insert-before');
      section.classList.remove('department-drag-over', 'dept-insert-before', 'dept-insert-after');

      if (dept && draggedDepartmentId !== null) {
        reorderDepartment(draggedDepartmentId, dept.id, insertBefore);
        return;
      }

      if (draggedBoardId !== null && !e.target.closest('.board-box')) {
        moveBoardToDepartment(draggedBoardId, dept ? dept.id : null);
      }
    });

    const header = document.createElement('div');
    header.className = 'department-header';

    if (!dept) {
      header.classList.add('department-header-none');
      header.innerHTML = `
        <span class="department-name-text">Sem departamento</span>
        <span class="department-mini-stats">${deptBoards.length} lista${deptBoards.length === 1 ? '' : 's'}</span>
      `;
    } else {
      header.innerHTML = `
        <span class="drag-handle department-drag-handle" title="Arrastar departamento" draggable="true">&#9776;</span>
        <span class="department-color-dot"></span>
        <span class="department-name-text"></span>
        <span class="department-mini-stats">${deptBoards.length} lista${deptBoards.length === 1 ? '' : 's'}</span>
        <button class="rename-btn department-edit-btn" title="Editar departamento">&#9998;</button>
        <button class="board-delete-btn department-delete-btn" title="Excluir departamento">&times;</button>
      `;
      header.querySelector('.department-name-text').textContent = dept.name;
      header.querySelector('.department-color-dot').style.background = dept.color;

      const deptDragHandle = header.querySelector('.department-drag-handle');
      deptDragHandle.addEventListener('click', (e) => e.stopPropagation());
      deptDragHandle.addEventListener('dragstart', (e) => {
        e.stopPropagation();
        draggedDepartmentId = dept.id;
        section.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', String(dept.id));
      });
      deptDragHandle.addEventListener('dragend', (e) => {
        e.stopPropagation();
        draggedDepartmentId = null;
        document.querySelectorAll('.department-section.dragging').forEach(el => el.classList.remove('dragging'));
        document.querySelectorAll('.dept-insert-before, .dept-insert-after').forEach(el => {
          el.classList.remove('dept-insert-before', 'dept-insert-after');
        });
      });

      header.querySelector('.department-edit-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        openDepartmentModal(dept);
      });

      header.querySelector('.department-delete-btn').addEventListener('click', (e) => {
        e.stopPropagation();
        confirmDeleteDepartment(dept.id);
      });
    }

    section.appendChild(header);

    const boardsWrap = document.createElement('div');
    boardsWrap.className = 'department-boards';

    if (deptBoards.length === 0) {
      const emptyMsg = document.createElement('div');
      emptyMsg.className = 'empty-msg';
      emptyMsg.textContent = dept ? 'Nenhuma lista neste departamento ainda.' : 'Nenhuma lista sem departamento.';
      boardsWrap.appendChild(emptyMsg);
    }

    deptBoards.forEach(board => {
      boardsWrap.appendChild(buildBoardBox(board));
    });

    const addCard = document.createElement('div');
    addCard.className = 'new-board-card new-board-card-mini';
    addCard.innerHTML = '<span>+</span><span>Adicionar lista</span>';
    addCard.addEventListener('click', () => openNewBoardModal(dept ? dept.id : null));
    boardsWrap.appendChild(addCard);

    section.appendChild(boardsWrap);

    return section;
  }

  function buildBoardBox(board) {
    const isExpanded = expandedBoardId === board.id;

    const box = document.createElement('div');
    box.className = 'board-box';
    box.dataset.boardId = board.id;

    // EVENTOS DE DRAG & DROP NA CAIXA DA LISTA (Drop Target)
    box.addEventListener('dragover', (e) => {
      e.preventDefault();
      e.stopPropagation();
      if (draggedBoardId !== null) {
        // Arrastando uma lista inteira: indica se vai inserir antes ou depois desta caixa
        if (draggedBoardId !== board.id) {
          const rect = box.getBoundingClientRect();
          const isTopHalf = (e.clientY - rect.top) < rect.height / 2;
          box.classList.toggle('board-insert-before', isTopHalf);
          box.classList.toggle('board-insert-after', !isTopHalf);
        }
      } else if (draggedTaskId !== null) {
        box.classList.add('drag-over');
      }
    });

    box.addEventListener('dragleave', (e) => {
      if (!box.contains(e.relatedTarget)) {
        box.classList.remove('drag-over');
        box.classList.remove('board-insert-before');
        box.classList.remove('board-insert-after');
      }
    });

    box.addEventListener('drop', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const insertBefore = box.classList.contains('board-insert-before');
      box.classList.remove('drag-over');
      box.classList.remove('board-insert-before');
      box.classList.remove('board-insert-after');

      if (draggedBoardId !== null) {
        reorderBoard(draggedBoardId, board.id, insertBefore);
        return;
      }

      // Se soltar na área geral do box e não em um item específico, adiciona no final da lista
      if (draggedTaskId !== null && draggedSourceBoardId !== null) {
        if (!e.target.closest('li')) {
          moveTaskToBoard(draggedSourceBoardId, board.id, draggedTaskId);
        }
      }
    });

    const deptSiblings = boards.filter(b => (b.departmentId || null) === (board.departmentId || null));
    const posInDept = deptSiblings.indexOf(board);
    const isFirstBoard = posInDept === 0;
    const isLastBoard = posInDept === deptSiblings.length - 1;

    const header = document.createElement('div');
    header.className = 'board-box-header';
    header.innerHTML = `
      <span class="drag-handle" title="Arrastar lista" draggable="true">&#9776;</span>
      <div class="move-group">
        <button class="move-btn board-move-up" title="Mover lista para cima" ${isFirstBoard ? 'disabled' : ''}>&#9650;</button>
        <button class="move-btn board-move-down" title="Mover lista para baixo" ${isLastBoard ? 'disabled' : ''}>&#9660;</button>
      </div>
      <button class="rename-btn" title="Renomear lista">&#9998;</button>
      <h3 class="board-name-text"></h3>
      <span class="board-mini-stats">${board.tasks.length}p · ${board.doneTasks.length}c</span>
      <select class="board-dept-select" title="Mover para departamento">
        ${buildDepartmentOptionsHTML(board.departmentId)}
      </select>
      <button class="board-delete-btn" title="Excluir lista">&times;</button>
    `;
    header.querySelector('.board-name-text').textContent = board.name;

    const boardDragHandle = header.querySelector('.drag-handle');
    boardDragHandle.addEventListener('click', (e) => e.stopPropagation());
    boardDragHandle.addEventListener('dragstart', (e) => {
      e.stopPropagation();
      draggedBoardId = board.id;
      box.classList.add('dragging');
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', String(board.id));
    });
    boardDragHandle.addEventListener('dragend', (e) => {
      e.stopPropagation();
      draggedBoardId = null;
      document.querySelectorAll('.board-box.dragging').forEach(el => el.classList.remove('dragging'));
      document.querySelectorAll('.board-insert-before, .board-insert-after').forEach(el => {
        el.classList.remove('board-insert-before', 'board-insert-after');
      });
    });

    header.querySelector('.board-move-up').addEventListener('click', (e) => {
      e.stopPropagation();
      moveBoard(board.id, 'up');
    });

    header.querySelector('.board-move-down').addEventListener('click', (e) => {
      e.stopPropagation();
      moveBoard(board.id, 'down');
    });

    header.querySelector('.rename-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      startRenameBoard(board, header);
    });

    const boardDeptSelect = header.querySelector('.board-dept-select');
    boardDeptSelect.addEventListener('click', (e) => e.stopPropagation());
    boardDeptSelect.addEventListener('change', (e) => {
      e.stopPropagation();
      const val = e.target.value;
      moveBoardToDepartment(board.id, val ? parseInt(val, 10) : null);
    });

    header.querySelector('.board-delete-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      confirmDeleteBoard(board.id);
    });

    header.addEventListener('click', () => {
      expandedBoardId = isExpanded ? null : board.id;
      renderBoardsColumn();
    });

    box.appendChild(header);

    if (isExpanded) {
      const body = document.createElement('div');
      body.className = 'board-box-body';

      const form = document.createElement('div');
      form.className = 'mini-task-form';
      form.innerHTML = `
        <input type="text" class="mini-task-input" placeholder="O que você precisa fazer?" autocomplete="off">
        <button type="button" class="add-btn">Adicionar</button>
      `;
      const miniInput = form.querySelector('.mini-task-input');
      const miniAddBtn = form.querySelector('.add-btn');
      form.addEventListener('click', (e) => e.stopPropagation());
      function submitMiniTask() {
        addTask(board.id, miniInput.value);
      }
      miniAddBtn.addEventListener('click', submitMiniTask);
      miniInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          submitMiniTask();
        }
      });
      body.appendChild(form);

      const list = document.createElement('ul');
      list.className = 'mini-pending-list';
      renderPendingTasks(board, list);
      body.appendChild(list);

      box.appendChild(body);
    }

    return box;
  }

  function startRenameBoard(board, header) {
    const nameEl = header.querySelector('.board-name-text');
    const inputEl = document.createElement('input');
    inputEl.type = 'text';
    inputEl.className = 'board-rename-input';
    inputEl.value = board.name;
    inputEl.addEventListener('click', (e) => e.stopPropagation());
    nameEl.replaceWith(inputEl);
    inputEl.focus();
    inputEl.select();

    function commit() {
      const newName = inputEl.value.trim();
      if (newName) {
        board.name = newName;
        saveToStorage();
      }
      renderBoardsColumn();
    }

    inputEl.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') commit();
      if (e.key === 'Escape') renderBoardsColumn();
    });
    inputEl.addEventListener('blur', commit);
  }

  function renderPendingTasks(board, list) {
    list.innerHTML = '';

    if (board.tasks.length === 0) {
      list.innerHTML = '<li style="all:unset; cursor:default;"><div class="empty-msg" style="width:100%">Nenhuma tarefa pendente.</div></li>';
      return;
    }

    const boardOptions = boards
      .filter(b => b.id !== board.id)
      .map(b => `<option value="${b.id}">${b.name.replace(/"/g, '&quot;')}</option>`)
      .join('');
    const hasOtherBoards = boardOptions.length > 0;

    board.tasks.forEach((task, i) => {
      const li = document.createElement('li');
      li.draggable = true;
      li.dataset.taskId = task.id;
      li.dataset.boardId = board.id;

      const priority = task.priority || null;
      if (priority) li.classList.add('pri-' + priority);

      const isFirstInGroup = i === 0 || (board.tasks[i - 1].priority || null) !== priority;
      const isLastInGroup = i === board.tasks.length - 1 || (board.tasks[i + 1].priority || null) !== priority;

      // EVENTOS DRAG AND DROP DO ITEM DA TAREFA
      li.addEventListener('dragstart', (e) => {
        draggedTaskId = task.id;
        draggedSourceBoardId = board.id;
        li.classList.add('dragging');
        e.dataTransfer.effectAllowed = 'move';
        e.dataTransfer.setData('text/plain', JSON.stringify({ boardId: board.id, taskId: task.id }));
      });

      li.addEventListener('dragend', () => {
        draggedTaskId = null;
        draggedSourceBoardId = null;
        li.classList.remove('dragging');
        document.querySelectorAll('.drag-over-item').forEach(el => el.classList.remove('drag-over-item'));
        document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
      });

      li.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (draggedTaskId !== null && draggedTaskId !== task.id) {
          li.classList.add('drag-over-item');
        }
      });

      li.addEventListener('dragleave', () => {
        li.classList.remove('drag-over-item');
      });

      li.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        li.classList.remove('drag-over-item');

        if (draggedTaskId !== null && draggedSourceBoardId !== null) {
          moveTaskToBoard(draggedSourceBoardId, board.id, draggedTaskId, i);
        }
      });

      if (task.editing) {
        li.draggable = false;
        li.innerHTML = `
          <div class="task-top-row">
            <div class="task-top-left">
              <span class="index">${i + 1}</span>
            </div>
            <div class="task-top-right">
              <button class="edit-btn" title="Salvar">&#10003;</button>
            </div>
          </div>
          <input type="text" class="edit-input" value="${task.text.replace(/"/g, '&quot;')}">
        `;
        const editInput = li.querySelector('.edit-input');
        editInput.addEventListener('click', (e) => e.stopPropagation());
        li.querySelector('.edit-btn').addEventListener('click', (e) => { e.stopPropagation(); saveEdit(board.id, task.id, editInput.value); });
        editInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') saveEdit(board.id, task.id, editInput.value);
          if (e.key === 'Escape') { task.editing = false; renderAll(); }
        });
        list.appendChild(li);
        editInput.focus();
        editInput.select();
        return;
      }

      li.innerHTML = `
        <div class="task-top-row">
          <div class="task-top-left">
            <span class="drag-handle" title="Arrastar tarefa">&#9776;</span>
            <span class="index">${i + 1}</span>
            <div class="move-group">
              <button class="move-btn move-up" title="Mover para cima" ${isFirstInGroup ? 'disabled' : ''}>&#9650;</button>
              <button class="move-btn move-down" title="Mover para baixo" ${isLastInGroup ? 'disabled' : ''}>&#9660;</button>
            </div>
            <button class="check-btn" title="Marcar como concluída"></button>
          </div>
          <div class="task-top-right">
            ${hasOtherBoards ? `
              <select class="move-board-select" title="Mover para outra lista">
                <option value="" disabled selected>Mover p/...</option>
                ${boardOptions}
              </select>
            ` : ''}
            <select class="move-hour-select" title="Enviar para um horário da Lista do dia">
              ${buildHourOptionsHTML()}
            </select>
            <select class="priority-select" title="Classificar prioridade">
              <option value="">Sem cor</option>
              <option value="red">Urgente</option>
              <option value="yellow">Média</option>
              <option value="blue">Baixa</option>
              <option value="green">Adiável</option>
            </select>
            <button class="edit-btn" title="Editar">&#9998;</button>
            <button class="delete-btn" title="Excluir">&times;</button>
          </div>
        </div>
        <span class="task-text"></span>
      `;
      li.addEventListener('click', (e) => e.stopPropagation());
      li.querySelector('.task-text').textContent = task.text;

      const select = li.querySelector('.priority-select');
      select.value = priority || '';
      select.style.background = PRIORITY_COLORS[priority || null];
      select.addEventListener('change', (e) => setPriority(board.id, task.id, e.target.value));

      const moveSelect = li.querySelector('.move-board-select');
      if (moveSelect) {
        moveSelect.addEventListener('change', (e) => {
          const targetBoardId = parseInt(e.target.value, 10);
          if (targetBoardId) {
            moveTaskToBoard(board.id, targetBoardId, task.id);
          }
        });
      }

      const moveHourSelect = li.querySelector('.move-hour-select');
      if (moveHourSelect) {
        moveHourSelect.addEventListener('change', (e) => {
          const hour = parseInt(e.target.value, 10);
          if (!Number.isNaN(hour)) {
            moveTaskToHour(board.id, task.id, hour);
          }
        });
      }

      li.querySelector('.move-up').addEventListener('click', () => moveTask(board.id, task.id, 'up'));
      li.querySelector('.move-down').addEventListener('click', () => moveTask(board.id, task.id, 'down'));
      li.querySelector('.check-btn').addEventListener('click', () => askComplete(board.id, task.id));
      li.querySelector('.edit-btn').addEventListener('click', () => startEdit(board.id, task.id));
      li.querySelector('.delete-btn').addEventListener('click', () => deleteTask(board.id, task.id, false));
      list.appendChild(li);
    });
  }

  // ---- Renderização das Tarefas Fixas ----
  function renderFixed() {
    // Atualiza o seletor de listas de destino, preservando a seleção atual quando possível
    const previousApplyValue = fixedApplySelect.value;
    fixedApplySelect.innerHTML = boards
      .map(b => `<option value="${b.id}">${b.name.replace(/"/g, '&quot;')}</option>`)
      .join('');
    if (boards.some(b => String(b.id) === previousApplyValue)) {
      fixedApplySelect.value = previousApplyValue;
    } else if (expandedBoardId && boards.some(b => b.id === expandedBoardId)) {
      fixedApplySelect.value = String(expandedBoardId);
    }

    fixedCountEl.textContent = fixedTasks.length;
    fixedListEl.innerHTML = '';

    if (fixedTasks.length === 0) {
      fixedListEl.innerHTML = '<li style="all:unset; cursor:default;"><div class="empty-msg" style="width:100%">Nenhuma tarefa fixa cadastrada.</div></li>';
    } else {
      fixedTasks.forEach(ft => {
        const li = document.createElement('li');
        li.className = 'fixed-item';
        li.innerHTML = `
          <input type="checkbox" ${selectedFixedIds.has(ft.id) ? 'checked' : ''}>
          <span class="task-text"></span>
          <button class="delete-btn" title="Excluir tarefa fixa">&times;</button>
        `;
        li.querySelector('.task-text').textContent = ft.text;
        li.querySelector('input[type="checkbox"]').addEventListener('change', (e) => {
          toggleFixedSelection(ft.id, e.target.checked);
        });
        li.querySelector('.delete-btn').addEventListener('click', () => deleteFixedTask(ft.id));
        fixedListEl.appendChild(li);
      });
    }

    updateFixedActionsBar();
  }

  function updateFixedActionsBar() {
    const selectedCount = selectedFixedIds.size;
    fixedSelectionInfo.textContent = selectedCount > 0 ? `${selectedCount} selecionada${selectedCount === 1 ? '' : 's'}` : '';
    fixedApplyBtn.disabled = selectedCount === 0 || boards.length === 0;
    fixedSelectAllBtn.textContent = (fixedTasks.length > 0 && fixedTasks.every(t => selectedFixedIds.has(t.id)))
      ? 'Desmarcar todas'
      : 'Selecionar todas';
  }

  function submitFixedTask() {
    addFixedTask(fixedTaskInput.value);
    fixedTaskInput.value = '';
    fixedTaskInput.focus();
  }

  fixedTaskAddBtn.addEventListener('click', submitFixedTask);
  fixedTaskInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      submitFixedTask();
    }
  });
  fixedSelectAllBtn.addEventListener('click', toggleSelectAllFixed);
  fixedApplyBtn.addEventListener('click', applySelectedFixedTasks);

  // ---- Diário ----
  function getAllDoneTasks() {
    let all = [];
    boards.forEach(board => {
      board.doneTasks.forEach(t => all.push({ ...t, boardId: board.id, boardName: board.name }));
    });
    return all;
  }

  function formatHourLabel(h) {
    return `${h}h`;
  }

  function formatTime(iso) {
    const d = new Date(iso);
    const hh = String(d.getHours()).padStart(2, '0');
    const mm = String(d.getMinutes()).padStart(2, '0');
    return `${hh}:${mm}`;
  }

  function renderDiary() {
    const all = getAllDoneTasks();
    diaryCount.textContent = all.length;
    renderHourTimeline(all);
    renderDailyReport(all);
  }

  function renderHourTimeline(all) {
    hourTimeline.innerHTML = '';

    const semHorario = all.filter(t => !t.completedAt);
    if (semHorario.length > 0) {
      hourTimeline.appendChild(buildHourRow('Sem horário', semHorario));
    }

    for (let h = 0; h < 24; h++) {
      const tasksAtHour = all.filter(t => t.completedAt && new Date(t.completedAt).getHours() === h);
      hourTimeline.appendChild(buildHourRow(formatHourLabel(h), tasksAtHour));
    }
  }

  function buildHourRow(label, tasksAtHour) {
    const row = document.createElement('div');
    row.className = 'hour-row' + (tasksAtHour.length > 0 ? ' has-tasks' : '');

    const labelEl = document.createElement('span');
    labelEl.className = 'hour-label';
    labelEl.textContent = label;
    row.appendChild(labelEl);

    const tasksWrap = document.createElement('div');
    tasksWrap.className = 'hour-tasks';

    if (tasksAtHour.length === 0) {
      const empty = document.createElement('span');
      empty.className = 'hour-empty';
      empty.textContent = '—';
      tasksWrap.appendChild(empty);
    } else {
      tasksAtHour.forEach(task => {
        const item = document.createElement('div');
        item.className = 'hour-task';
        item.innerHTML = `
          ${task.completedAt ? `<span class="hour-time">${formatTime(task.completedAt)}</span>` : ''}
          <span class="task-text"></span>
          <span class="hour-task-board"></span>
          <button class="delete-btn" title="Excluir">&times;</button>
        `;
        item.querySelector('.task-text').textContent = task.text;
        item.querySelector('.hour-task-board').textContent = task.boardName;
        item.querySelector('.delete-btn').addEventListener('click', () => deleteTask(task.boardId, task.id, true));
        tasksWrap.appendChild(item);
      });
    }

    row.appendChild(tasksWrap);
    return row;
  }

  function renderDailyReport(all) {
    reportContent.innerHTML = '';

    if (all.length === 0) {
      reportContent.innerHTML = '<div class="empty-msg">Nenhuma tarefa concluída ainda.</div>';
      return;
    }

    const total = document.createElement('p');
    total.className = 'report-total';
    total.innerHTML = `Total de <strong>${all.length}</strong> tarefa${all.length === 1 ? '' : 's'} concluída${all.length === 1 ? '' : 's'} em todas as listas.`;
    reportContent.appendChild(total);

    const semHorario = all.filter(t => !t.completedAt);
    if (semHorario.length > 0) {
      reportContent.appendChild(buildReportBlock('Sem horário', semHorario));
    }

    for (let h = 0; h < 24; h++) {
      const tasksAtHour = all.filter(t => t.completedAt && new Date(t.completedAt).getHours() === h);
      if (tasksAtHour.length > 0) {
        reportContent.appendChild(buildReportBlock(formatHourLabel(h), tasksAtHour));
      }
    }
  }

  function buildReportBlock(label, tasksAtHour) {
    const block = document.createElement('div');
    block.className = 'report-hour-block';
    const names = tasksAtHour
      .map(t => t.completedAt ? `${t.text} (${formatTime(t.completedAt)} — ${t.boardName})` : `${t.text} (${t.boardName})`)
      .join(', ');
    block.innerHTML = `<span class="report-hour-label">${label}</span><span class="report-tasks"></span>`;
    block.querySelector('.report-tasks').textContent = names;
    return block;
  }

  function setDateSubtitle() {
    const hoje = new Date();
    const dia = hoje.getDate();
    const mes = MESES[hoje.getMonth()];
    document.getElementById('date-subtitle').textContent = `dia ${dia} de ${mes}`;
  }

  // ---- Abas de navegação ----
  function initTabs() {
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanels = document.querySelectorAll('.tab-panel');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tab;

        tabBtns.forEach(b => b.classList.toggle('active', b === btn));
        tabPanels.forEach(panel => {
          panel.classList.toggle('active', panel.id === `tab-${target}`);
        });
      });
    });
  }

  // ---- Inicialização ----
  function init() {
    setDateSubtitle();
    loadFromStorage();
    renderHeaderName();
    renderAll();
    initTabs();
  }

  init();
</script>

</body>
</html>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
