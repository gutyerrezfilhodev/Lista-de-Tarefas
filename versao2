  /* ---- Modais ---- */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 20px;
  }

  .modal-overlay.open {
    display: flex;
  }

  .modal-box {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    max-width: 360px;
    width: 100%;
    text-align: center;
    animation: appear 0.18s ease;
  }

  .modal-box p {
    margin: 0 0 20px;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .modal-box input[type="text"] {
    width: 100%;
    margin-bottom: 16px;
  }

  .modal-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .modal-actions button {
    flex: 1;
    padding: 10px 0;
    border-radius: 8px;
    border: none;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  .modal-actions button:hover { filter: brightness(1.1); }

  .modal-yes {
    background: var(--accent);
    color: #12241c;
  }

  .modal-no {
    background: var(--line);
    color: var(--ink);
  }
</style>
