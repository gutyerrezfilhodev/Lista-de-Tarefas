    <button class="tab-btn" data-tab="tasks">Tarefas</button>
    <button class="tab-btn" data-tab="fixed">Tarefas Fixas</button>
    <button class="tab-btn" data-tab="diary">Diário</button>
  </div>

  <div class="tab-panel active" id="tab-daily">
    <div class="diary-panel">
      <h2 class="daily-title" id="daily-title">Lista do dia</h2>
