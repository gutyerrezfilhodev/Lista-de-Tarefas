<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Lista de Tarefas - Gutyerrez Filho</title>
<style>
  :root {
    --bg: #1b1d22;
    --panel: #23262d;
    --ink: #eef0f3;
    --muted: #8a8f9a;
    --accent: #6ee7b7;
    --accent-dim: #3fae82;
    --line: #33363f;
    --danger: #e2685f;
    --pri-red: #e2685f;
    --pri-yellow: #e0b93f;
    --pri-blue: #4f9fe8;
    --pri-green: #5fd88a;
    --pri-none: #4a4e58;
    --social-color: #b98bf0;
    --social-color-dim: #9457d6;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  html { scroll-padding-top: env(safe-area-inset-top, 0px); }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    display: flex;
    justify-content: center;
    padding: 48px 20px;
  }

  .app {
    width: 100%;
    max-width: 1100px;
  }

  h1 {
    font-size: 1.6rem;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }

  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .header-row h1 {
    flex: 1;
    min-width: 220px;
  }

  .user-name-wrap {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .user-name-input {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    padding: 2px 6px;
    width: auto;
    min-width: 160px;
  }

  .user-name-edit-btn {
    font-size: 0.9rem;
  }

  .social-card-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--social-color) 16%, var(--panel));
    border: 2px solid var(--social-color);
    border-radius: 12px;
    padding: 10px 16px;
    cursor: pointer;
    color: var(--ink);
    font-family: inherit;
    transition: filter 0.15s ease, transform 0.1s ease;
    flex-shrink: 0;
  }

  .social-card-btn:hover { filter: brightness(1.1); }
  .social-card-btn:active { transform: scale(0.98); }

  .social-card-title {
    color: var(--social-color);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .social-card-count {
    background: var(--social-color);
    color: #1b1d22;
    border-radius: 999px;
    padding: 2px 8px;
    font-size: 0.7rem;
    font-weight: 700;
    min-width: 20px;
    text-align: center;
  }

  .social-modal-box {
    max-width: 460px;
    width: 100%;
    text-align: left;
    border: 2px solid var(--social-color);
  }

  .social-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 16px;
  }

  .social-modal-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: var(--social-color);
    text-transform: none;
    letter-spacing: normal;
  }

  .social-add-form {
    margin: 0 0 16px;
  }

  .social-add-form input[type="number"] {
    max-width: 90px;
    flex: none;
  }

  .social-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 340px;
    overflow-y: auto;
  }

  .social-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-left: 4px solid var(--social-color);
    border-radius: 10px;
    padding: 10px 12px;
    animation: appear 0.18s ease;
  }

  .social-item .social-name {
    flex: 1;
    font-size: 0.9rem;
    word-break: break-word;
  }

  .social-usage-input-inline {
    width: 56px;
    flex: none;
    background: var(--panel);
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: 6px;
    padding: 4px 6px;
    font-size: 0.8rem;
    outline: none;
    text-align: center;
  }

  .social-usage-label {
    font-size: 0.7rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .subtitle {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 28px;
  }

  /* ---- Abas de navegação ---- */
  .tabs-nav {
    display: flex;
    gap: 8px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 20px;
  }

  .tab-btn {
    background: none;
    border: none;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 600;
    padding: 10px 4px;
    margin-bottom: -1px;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .tab-btn:hover { color: var(--ink); }

  .tab-btn.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ---- Layout principal ---- */
  .boards-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* ---- Departamentos ---- */
  .department-section {
    border: 2px solid var(--dept-color, var(--line));
    border-radius: 14px;
    overflow: hidden;
    background: color-mix(in srgb, var(--dept-color, var(--line)) 10%, var(--panel));
    transition: border-color 0.15s ease, background-color 0.15s ease, opacity 0.15s ease, transform 0.15s ease;
  }

  .department-section.department-drag-over {
    border-color: var(--accent);
    background-color: rgba(110, 231, 183, 0.03);
  }

  .department-section.dept-insert-before {
    border-top: 2px solid var(--accent);
  }

  .department-section.dept-insert-after {
    border-bottom: 2px solid var(--accent);
  }

  .department-section.dragging {
    opacity: 0.4;
    transform: scale(0.98);
  }

  .department-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--dept-color, var(--line)) 55%, transparent);
    background: color-mix(in srgb, var(--dept-color, var(--line)) 22%, transparent);
  }

  .department-header-none {
    color: var(--muted);
  }

  .department-color-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
    border: 1px solid rgba(0,0,0,0.25);
  }

  .department-name-text {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0;
    word-break: break-word;
  }

  .department-header-none .department-name-text {
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .department-mini-stats {
    font-size: 0.68rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .department-boards {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
  }

  .new-board-card-mini {
    min-height: 44px;
    padding: 12px;
    font-size: 0.82rem;
  }

  /* ---- Caixinha de lista ---- */
  .board-box {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  /* Indicador visual de quando uma lista é alvo de soltar */
  .board-box.drag-over {
    border-color: var(--accent);
    background-color: rgba(110, 231, 183, 0.03);
  }

  /* Indicadores de reordenação ao arrastar uma lista inteira */
  .board-box.dragging {
    opacity: 0.4;
    transform: scale(0.98);
  }

  .board-box.board-insert-before {
    border-top: 2px solid var(--accent);
  }

  .board-box.board-insert-after {
    border-bottom: 2px solid var(--accent);
  }

  .board-box-header {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    cursor: pointer;
  }

  .board-box-header:hover { background: rgba(255,255,255,0.02); }

  .board-name-text {
    flex: 1;
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    word-break: break-word;
  }

  .board-rename-input {
    flex: 1;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 6px 8px;
  }

  .board-mini-stats {
    font-size: 0.68rem;
    color: var(--muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .rename-btn, .board-delete-btn {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.95rem;
    line-height: 1;
    padding: 3px 4px;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .rename-btn:hover { color: var(--accent); }
  .board-delete-btn:hover { color: var(--danger); }

  .board-box-body {
    padding: 0 16px 16px;
    border-top: 1px solid var(--line);
  }

  .mini-task-form {
    display: flex;
    gap: 8px;
    margin: 14px 0;
  }

  .new-board-card {
    background: transparent;
    border: 1px dashed var(--line);
    border-radius: 12px;
    padding: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 600;
    font-size: 0.9rem;
    min-height: 60px;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .new-board-card:hover {
    border-color: var(--accent-dim);
    background: rgba(110, 231, 183, 0.06);
  }

  /* ---- Inputs ---- */
  input[type="text"] {
    flex: 1;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.15s ease;
  }

  input[type="text"]:focus {
    border-color: var(--accent-dim);
  }

  button.add-btn {
    background: var(--accent);
    color: #12241c;
    border: none;
    padding: 0 18px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.9rem;
    transition: filter 0.15s ease;
  }

  button.add-btn:hover { filter: brightness(1.08); }

  h2 {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin: 0 0 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  h2 .count {
    background: var(--panel);
    border: 1px solid var(--line);
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.7rem;
    color: var(--ink);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 20px;
  }

  li {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    background: var(--bg);
    border: 1px solid var(--line);
    border-left: 4px solid var(--pri-none);
    border-radius: 10px;
    padding: 10px 12px;
    animation: appear 0.18s ease;
    cursor: grab;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  li:active {
    cursor: grabbing;
  }

  li.dragging {
    opacity: 0.4;
    transform: scale(0.98);
  }

  li.drag-over-item {
    border-top: 2px solid var(--accent);
  }

  .task-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }

  .task-top-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .task-top-right {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .drag-handle {
    cursor: grab;
    color: var(--muted);
    font-size: 0.9rem;
    user-select: none;
    padding: 0 2px;
  }

  .drag-handle:active {
    cursor: grabbing;
  }

  li.pri-red { border-left-color: var(--pri-red); }
  li.pri-yellow { border-left-color: var(--pri-yellow); }
  li.pri-blue { border-left-color: var(--pri-blue); }
  li.pri-green { border-left-color: var(--pri-green); }

  @keyframes appear {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .index {
    min-width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--muted);
    background: rgba(255,255,255,0.04);
    border-radius: 6px;
  }

  .check-btn {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    border: 2px solid var(--accent-dim);
    background: transparent;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.15s ease;
  }

  .check-btn:hover { background: rgba(110, 231, 183, 0.15); }

  .task-text {
    display: block;
    width: 100%;
    font-size: 0.9rem;
    line-height: 1.4;
    word-break: break-word;
    padding-top: 2px;
  }

  .delete-btn {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 4px;
    transition: color 0.15s ease;
  }

  .delete-btn:hover { color: var(--danger); }

  .edit-btn {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
    padding: 4px;
    transition: color 0.15s ease;
    flex-shrink: 0;
  }

  .edit-btn:hover { color: var(--accent); }

  .edit-input {
    display: block;
    width: 100%;
    background: var(--panel);
    border: 1px solid var(--accent-dim);
    color: var(--ink);
    padding: 8px 10px;
    border-radius: 6px;
    font-size: 0.9rem;
    outline: none;
  }

  .priority-select {
    border: none;
    border-radius: 6px;
    padding: 3px 5px;
    font-size: 0.65rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    color: #12141a;
    flex-shrink: 0;
    max-width: 82px;
  }

  .move-board-select {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 6px;
    padding: 3px 5px;
    font-size: 0.65rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    max-width: 90px;
  }

  .move-board-select:hover {
    border-color: var(--accent-dim);
    color: var(--ink);
  }

  .daily-hour-select {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 6px;
    padding: 3px 5px;
    font-size: 0.65rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    max-width: 90px;
    flex-shrink: 0;
  }

  .daily-hour-select:hover {
    border-color: var(--accent-dim);
    color: var(--ink);
  }

  .move-hour-select {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 6px;
    padding: 3px 5px;
    font-size: 0.65rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    max-width: 100px;
    flex-shrink: 0;
  }

  .move-hour-select:hover {
    border-color: var(--accent-dim);
    color: var(--ink);
  }

  .board-dept-select {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--muted);
    border-radius: 6px;
    padding: 4px 6px;
    font-size: 0.68rem;
    font-weight: 600;
    cursor: pointer;
    outline: none;
    max-width: 110px;
    flex-shrink: 0;
  }

  .board-dept-select:hover {
    border-color: var(--accent-dim);
    color: var(--ink);
  }

  .move-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex-shrink: 0;
  }

  .move-btn {
    background: none;
    border: none;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.6rem;
    line-height: 1;
    padding: 1px 3px;
    transition: color 0.15s ease;
  }

  .move-btn:hover:not(:disabled) { color: var(--accent); }

  .move-btn:disabled {
    opacity: 0.25;
    cursor: default;
  }

  .empty-msg {
    color: var(--muted);
    font-size: 0.8rem;
    padding: 14px 0;
    text-align: center;
    border: 1px dashed var(--line);
    border-radius: 10px;
  }

  /* ---- Diário ---- */
  .diary-column {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .diary-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
  }

  .hour-timeline {
    display: flex;
    flex-direction: column;
    max-height: 640px;
    overflow-y: auto;
    padding-right: 4px;
  }

  .hour-row {
    display: flex;
    gap: 12px;
    padding: 8px 4px;
    border-bottom: 1px solid var(--line);
  }

  .hour-row:last-child { border-bottom: none; }

  .hour-label {
    min-width: 40px;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted);
    padding-top: 2px;
  }

  .hour-row.has-tasks .hour-label {
    color: var(--accent);
  }

  .hour-tasks {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .hour-empty {
    color: var(--muted);
    font-size: 0.8rem;
    opacity: 0.5;
  }

  .hour-task {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 6px 10px;
  }

  .hour-task .hour-time {
    font-size: 0.7rem;
    color: var(--muted);
    flex-shrink: 0;
  }

  .hour-task .task-text {
    font-size: 0.85rem;
    text-decoration: line-through;
    color: var(--muted);
    flex: 1;
  }

  .hour-task-board {
    font-size: 0.65rem;
    color: var(--accent);
    background: rgba(110, 231, 183, 0.1);
    border-radius: 999px;
    padding: 2px 8px;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .report-total {
    font-size: 0.85rem;
    color: var(--ink);
    margin: 0 0 14px;
  }

  .report-total strong { color: var(--accent); }

  .report-hour-block {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.85rem;
  }

  .report-hour-block:last-child { border-bottom: none; }

  .report-hour-block .report-hour-label {
    font-weight: 700;
    color: var(--accent);
    margin-right: 6px;
  }

  .report-hour-block .report-tasks {
    color: var(--ink);
  }

  /* ---- Lista do dia ---- */
  .daily-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
    margin: 0 0 16px;
  }

  .daily-hour-row {
    display: flex;
    gap: 12px;
    padding: 10px 4px;
    border-bottom: 1px solid var(--line);
  }

  .daily-hour-row:last-child { border-bottom: none; }

  .daily-hour-left {
    min-width: 40px;
    flex-shrink: 0;
    padding-top: 8px;
  }

  .daily-hour-row.has-tasks .hour-label {
    color: var(--accent);
  }

  .daily-hour-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 4px;
    border-radius: 10px;
    transition: background-color 0.15s ease;
  }

  .daily-hour-body.drag-over {
    background-color: rgba(110, 231, 183, 0.06);
    outline: 2px dashed var(--accent-dim);
  }

  .daily-task-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .daily-task-list li.task-done .task-text {
    text-decoration: line-through;
    color: var(--muted);
  }

  .daily-add-form {
    display: flex;
    gap: 8px;
  }

  .daily-add-form input[type="text"] {
    font-size: 0.82rem;
    padding: 8px 10px;
  }

  .daily-add-form .add-btn {
    padding: 0 14px;
    flex-shrink: 0;
  }

  .daily-hour-full-msg {
    font-size: 0.75rem;
    color: var(--muted);
    font-style: italic;
  }

  /* ---- Tarefas Fixas ---- */
  .fixed-column {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .fixed-panel {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 20px;
  }

  .fixed-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fixed-item {
    display: flex;
    align-items: center;
    gap: 8px;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 10px 12px;
    animation: appear 0.18s ease;
  }

  .fixed-item input[type="checkbox"] {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
    cursor: pointer;
    flex-shrink: 0;
  }

  .fixed-item .task-text {
    flex: 1;
  }

  .fixed-actions-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .fixed-selection-info {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .fixed-add-controls {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .apply-select {
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--ink);
    border-radius: 8px;
    padding: 9px 10px;
    font-size: 0.85rem;
    outline: none;
    cursor: pointer;
  }

  .apply-select:hover { border-color: var(--accent-dim); }

  button.apply-btn {
    background: var(--accent);
    color: #12241c;
    border: none;
    padding: 9px 16px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    font-size: 0.85rem;
    white-space: nowrap;
    transition: filter 0.15s ease;
  }

  button.apply-btn:hover:not(:disabled) { filter: brightness(1.08); }

  button.apply-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  button.select-all-btn {
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  button.select-all-btn:hover {
    color: var(--ink);
    border-color: var(--accent-dim);
  }

  /* ---- Modais ---- */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.55);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
    padding: 20px;
  }

  .modal-overlay.open {
    display: flex;
  }

  .modal-box {
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    max-width: 360px;
    width: 100%;
    text-align: center;
    animation: appear 0.18s ease;
  }

  .modal-box p {
    margin: 0 0 20px;
    font-size: 0.95rem;
    color: var(--ink);
  }

  .modal-box input[type="text"] {
    width: 100%;
    margin-bottom: 16px;
  }

  .modal-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .modal-actions button {
    flex: 1;
    padding: 10px 0;
    border-radius: 8px;
    border: none;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: filter 0.15s ease;
  }

  .modal-actions button:hover { filter: brightness(1.1); }

  .modal-yes {
    background: var(--accent);
    color: #12241c;
  }

  .modal-no {
    background: var(--line);
    color: var(--ink);
  }

  .color-swatch-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .color-swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }

  .color-swatch:hover {
    transform: scale(1.1);
  }

  .color-swatch.selected {
    border-color: var(--ink);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1b1d22;
      --panel: #23262d;
      --ink: #eef0f3;
    }
  }
</style>
</head>
<body>

<div class="app">
  <div class="header-row">
    <h1>Lista de Tarefas - <span class="user-name-wrap" id="user-name-wrap"><span class="user-name-text" id="user-name-text"></span><button class="rename-btn user-name-edit-btn" id="user-name-edit-btn" title="Editar nome">&#9998;</button></span></h1>
    <button type="button" class="social-card-btn" id="social-card-btn">
